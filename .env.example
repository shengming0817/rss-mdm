# Copy to .env (ignored by Git). Empty TLS settings use localhost development certificates.
MDM_PRODUCT_ORIGIN=
MDM_GATEWAY_PUBLISH=127.0.0.1::8445
MDM_GATEWAY_TLS_CERT_FILE=
MDM_GATEWAY_TLS_KEY_FILE=

# External certificate example: set all three origin/certificate/key values together.
# Paths are relative to the worktree root; absolute paths are also supported.
# MDM_PRODUCT_ORIGIN=https://mdm.example.com
# MDM_GATEWAY_PUBLISH=0.0.0.0:443:8445
# MDM_GATEWAY_TLS_CERT_FILE=./deployment/certs/fullchain.pem
# MDM_GATEWAY_TLS_KEY_FILE=./deployment/certs/privkey.pem
