{
  "$defs": {
    "Cancellation": {
      "enum": [
        "none",
        "requested",
        "confirmed"
      ],
      "type": "string"
    },
    "Delivery": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "queued",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "claimed",
              "type": "string"
            },
            "leaseUntil": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "attempt",
            "leaseUntil"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "attempt": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "received",
              "type": "string"
            },
            "leaseUntil": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "attempt",
            "leaseUntil"
          ],
          "type": "object"
        }
      ]
    },
    "Execution": {
      "enum": [
        "not_started",
        "running",
        "succeeded",
        "failed",
        "waiting_reboot",
        "unknown"
      ],
      "type": "string"
    },
    "RunState": {
      "additionalProperties": false,
      "properties": {
        "cancellation": {
          "$ref": "#/$defs/Cancellation"
        },
        "deadline": {
          "format": "int64",
          "type": "integer"
        },
        "delivery": {
          "$ref": "#/$defs/Delivery"
        },
        "execution": {
          "$ref": "#/$defs/Execution"
        },
        "startedAt": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "delivery",
        "execution",
        "cancellation",
        "deadline"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attemptId": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "availableAt": {
      "format": "int64",
      "type": "integer"
    },
    "deadline": {
      "format": "int64",
      "type": "integer"
    },
    "requestId": {
      "format": "uuid",
      "type": "string"
    },
    "result": true,
    "runId": {
      "format": "uuid",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    }
  },
  "required": [
    "requestId",
    "runId",
    "state",
    "availableAt",
    "deadline"
  ],
  "title": "Status",
  "type": "object"
}
