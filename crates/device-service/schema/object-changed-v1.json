{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mdm.device.object-changed.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "tenant": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "historyEpoch": {
      "type": "string",
      "format": "uuid"
    },
    "object": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "oldDevices": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string"
      }
    },
    "newDevices": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "v",
    "tenant",
    "revision",
    "historyEpoch",
    "object",
    "oldDevices",
    "newDevices"
  ]
}
