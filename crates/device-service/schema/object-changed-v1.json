{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mdm.device.object-changed.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "tenant": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "historyEpoch": {
      "type": "string",
      "format": "uuid"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "endpoint",
            "association"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "oldDevices": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "format": "uuid",
        "minLength": 36,
        "maxLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "not": {
          "const": "00000000-0000-0000-0000-000000000000"
        }
      }
    },
    "newDevices": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "format": "uuid",
        "minLength": 36,
        "maxLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "not": {
          "const": "00000000-0000-0000-0000-000000000000"
        }
      }
    }
  },
  "required": [
    "v",
    "tenant",
    "revision",
    "historyEpoch",
    "object",
    "oldDevices",
    "newDevices"
  ]
}
