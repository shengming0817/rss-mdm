{
  "$defs": {
    "Action": {
      "description": "Each action owns its inputs; registration never requires a fictitious resource.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A side-effecting or collection action admitted on Agent check-in.",
          "properties": {
            "frequency": {
              "$ref": "#/$defs/Frequency",
              "default": "once_per_version",
              "description": "History deduplication rule; defaults to once per version."
            },
            "kind": {
              "const": "execution",
              "type": "string"
            },
            "parameters": {
              "$ref": "#/$defs/ParameterSources",
              "description": "Complete parameter sources validated against the selected Resource."
            },
            "resource": {
              "$ref": "#/$defs/ExactResourceBinding",
              "description": "Exact immutable script resource."
            },
            "runLifetimeSeconds": {
              "description": "Maximum lifetime of each admitted run, from 60 seconds through seven days.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "schedule": {
              "$ref": "#/$defs/Schedule",
              "default": {
                "jitterSeconds": 0,
                "misfire": {
                  "kind": "coalesce_one"
                },
                "notBefore": 0,
                "trigger": {
                  "kind": "check_in",
                  "minimumSeconds": 60
                },
                "until": null,
                "window": null
              },
              "description": "Calendar and event conditions; defaults to check-in without an end."
            }
          },
          "required": [
            "kind",
            "resource",
            "parameters",
            "runLifetimeSeconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A native MDM read template using the same schedule and membership frequency.",
          "properties": {
            "frequency": {
              "$ref": "#/$defs/Frequency",
              "default": "once_per_version",
              "description": "Existing Policy execution frequency."
            },
            "kind": {
              "const": "native_collection",
              "type": "string"
            },
            "resource": {
              "$ref": "#/$defs/ExactResourceBinding",
              "description": "Exact immutable native template."
            },
            "runLifetimeSeconds": {
              "description": "Lifetime of the accepted collection.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "schedule": {
              "$ref": "#/$defs/Schedule",
              "default": {
                "jitterSeconds": 0,
                "misfire": {
                  "kind": "coalesce_one"
                },
                "notBefore": 0,
                "trigger": {
                  "kind": "check_in",
                  "minimumSeconds": 60
                },
                "until": null,
                "window": null
              },
              "description": "Calendar and check-in trigger."
            }
          },
          "required": [
            "kind",
            "resource",
            "runLifetimeSeconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A persistent native configuration without a script schedule.",
          "properties": {
            "exit": {
              "$ref": "#/$defs/Exit",
              "default": "retain",
              "description": "What to do when this configuration no longer has an owner."
            },
            "kind": {
              "const": "configuration",
              "type": "string"
            },
            "resource": {
              "$ref": "#/$defs/ExactResourceBinding",
              "description": "Exact immutable native configuration resource."
            }
          },
          "required": [
            "kind",
            "resource"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Enterprise software installed or removed through the Agent.",
          "properties": {
            "admissionOperation": {
              "description": "Exact enterprise approval to freeze into this execution version.",
              "format": "uuid",
              "type": "string"
            },
            "delivery": {
              "$ref": "#/$defs/SoftwareDelivery",
              "description": "Explicit content or frozen native-source delivery authority."
            },
            "intent": {
              "$ref": "#/$defs/SoftwareIntent",
              "description": "Required, self-service, or explicit removal semantics."
            },
            "kind": {
              "const": "software",
              "type": "string"
            },
            "resource": {
              "$ref": "#/$defs/SoftwareResourceBinding",
              "description": "Approved logical software release and exact platform variants."
            },
            "rollout": {
              "$ref": "#/$defs/SoftwareRollout",
              "description": "Administrator-authored rollout stages."
            },
            "runLifetimeSeconds": {
              "description": "Maximum lifetime of one task.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "schedule": {
              "$ref": "#/$defs/Schedule",
              "default": {
                "jitterSeconds": 0,
                "misfire": {
                  "kind": "coalesce_one"
                },
                "notBefore": 0,
                "trigger": {
                  "kind": "check_in",
                  "minimumSeconds": 60
                },
                "until": null,
                "window": null
              },
              "description": "Device execution schedule and maintenance window."
            }
          },
          "required": [
            "kind",
            "delivery",
            "resource",
            "intent",
            "admissionOperation",
            "runLifetimeSeconds",
            "rollout"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Install only the product's approved Agent through the source MDM channel.",
          "properties": {
            "admissionOperation": {
              "description": "Exact approval operation, rechecked before any side effect.",
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "ensure_agent_installed",
              "type": "string"
            },
            "resource": {
              "$ref": "#/$defs/SoftwareResourceBinding",
              "description": "Exact approved Agent release; product identity is checked at publication."
            },
            "runLifetimeSeconds": {
              "description": "Bounded lifetime of this installation and its registration handoff.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "schedule": {
              "$ref": "#/$defs/Schedule",
              "default": {
                "jitterSeconds": 0,
                "misfire": {
                  "kind": "coalesce_one"
                },
                "notBefore": 0,
                "trigger": {
                  "kind": "check_in",
                  "minimumSeconds": 60
                },
                "until": null,
                "window": null
              },
              "description": "Source-channel scheduling and cooldown."
            }
          },
          "required": [
            "kind",
            "resource",
            "admissionOperation",
            "runLifetimeSeconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ask an independently registered Agent to open the standard MDM enrollment flow.",
          "properties": {
            "kind": {
              "const": "request_mdm_enrollment",
              "type": "string"
            },
            "organization": {
              "description": "Target organization; the product verifies its enrollment authority.",
              "format": "uuid",
              "type": "string"
            },
            "runLifetimeSeconds": {
              "description": "Bounded lifetime; opening the UI does not complete enrollment.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "schedule": {
              "$ref": "#/$defs/Schedule",
              "default": {
                "jitterSeconds": 0,
                "misfire": {
                  "kind": "coalesce_one"
                },
                "notBefore": 0,
                "trigger": {
                  "kind": "check_in",
                  "minimumSeconds": 60
                },
                "until": null,
                "window": null
              },
              "description": "Source-channel scheduling and cooldown."
            }
          },
          "required": [
            "kind",
            "organization",
            "runLifetimeSeconds"
          ],
          "type": "object"
        }
      ]
    },
    "Architecture": {
      "description": "Machine architecture required by a resource variant.",
      "oneOf": [
        {
          "const": "x86_64",
          "description": "64-bit x86.",
          "type": "string"
        },
        {
          "const": "aarch64",
          "description": "64-bit ARM.",
          "type": "string"
        }
      ]
    },
    "Change": {
      "description": "Closed configuration mutations. Execution progress cannot mutate this CAS.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Create or replace the complete definition at an expected CAS.",
          "properties": {
            "action": {
              "const": "put",
              "type": "string"
            },
            "definition": {
              "$ref": "#/$defs/Definition",
              "description": "Replacement definition."
            },
            "enabled": {
              "description": "Requested enabled state.",
              "type": "boolean"
            }
          },
          "required": [
            "action",
            "definition",
            "enabled"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Enable the existing definition without changing execution content.",
          "properties": {
            "action": {
              "const": "enable",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Disable the existing definition without changing execution content.",
          "properties": {
            "action": {
              "const": "disable",
              "type": "string"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      ]
    },
    "Definition": {
      "additionalProperties": false,
      "description": "Complete authored Policy definition, without execution progress.",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action",
          "description": "Closed action or configuration semantics."
        },
        "scope": {
          "description": "Opaque Scope identity; Scope alone owns membership and entry coordinates.",
          "format": "uuid",
          "type": "string"
        },
        "selfService": {
          "anyOf": [
            {
              "$ref": "#/$defs/SelfService"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional script self-service publication and presentation."
        }
      },
      "required": [
        "scope",
        "action"
      ],
      "type": "object"
    },
    "ExactResourceBinding": {
      "additionalProperties": false,
      "description": "Exact selection for a script or native configuration.",
      "properties": {
        "architecture": {
          "$ref": "#/$defs/Architecture",
          "description": "Requested machine architecture."
        },
        "id": {
          "description": "Opaque resource identity.",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform",
          "description": "Requested resource platform."
        },
        "variant": {
          "description": "Exact resource variant key.",
          "type": "string"
        },
        "version": {
          "description": "Immutable resource version identity.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "platform",
        "architecture",
        "variant"
      ],
      "type": "object"
    },
    "Exit": {
      "description": "Supported configuration behavior when the last assignment exits.",
      "oneOf": [
        {
          "const": "retain",
          "description": "Retain effects when the assignment no longer applies.",
          "type": "string"
        },
        {
          "const": "remove",
          "description": "Remove only effects that the selected resource supports removing.",
          "type": "string"
        }
      ]
    },
    "Frequency": {
      "description": "Execution-history rule evaluated when a device checks in.",
      "oneOf": [
        {
          "const": "once_per_version",
          "description": "At most once for each immutable execution version and registration.",
          "type": "string"
        },
        {
          "const": "once_per_entry",
          "description": "At most once for each membership entry and registration.",
          "type": "string"
        },
        {
          "const": "every_trigger",
          "description": "Each distinct due trigger, subject to outstanding execution safety.",
          "type": "string"
        }
      ]
    },
    "Misfire": {
      "description": "How to handle a due occurrence missed while the device was offline.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Reject occurrences later than the explicit tolerance.",
          "properties": {
            "kind": {
              "const": "skip",
              "type": "string"
            },
            "maxLatenessSeconds": {
              "description": "Explicit tolerance beyond the computed available time.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "maxLatenessSeconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Admit only the most recent occurrence after an offline gap.",
          "properties": {
            "kind": {
              "const": "coalesce_one",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ParameterSource": {
      "description": "Where one Resource-declared argument obtains its value.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Administrator-selected literal; callers cannot override it.",
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "pattern": "^[^\\u0000]*$",
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "maximum": 9223372036854775807,
                  "minimum": -9223372036854775808,
                  "type": "integer"
                }
              ],
              "description": "Value checked against the Resource's parameter schema."
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Required call-time argument, governed by the same Resource schema.",
          "properties": {
            "kind": {
              "const": "input",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "ParameterSources": {
      "additionalProperties": {
        "$ref": "#/$defs/ParameterSource"
      },
      "description": "Complete parameter-source map; Resource owns all value constraints.",
      "type": "object"
    },
    "Platform": {
      "description": "Execution platform selected by the product resource resolver.",
      "oneOf": [
        {
          "const": "windows",
          "description": "Windows execution.",
          "type": "string"
        },
        {
          "const": "macos",
          "description": "macOS execution.",
          "type": "string"
        }
      ]
    },
    "Schedule": {
      "additionalProperties": false,
      "description": "Optional-ended calendar conditions, with no durable scheduler state.",
      "properties": {
        "jitterSeconds": {
          "description": "Deterministic maximum jitter, bounded to one hour.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "misfire": {
          "$ref": "#/$defs/Misfire",
          "default": {
            "kind": "coalesce_one"
          },
          "description": "Late-arrival behavior."
        },
        "notBefore": {
          "description": "Earliest allowed Unix second.",
          "format": "int64",
          "type": "integer"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger",
          "description": "Event or calendar trigger."
        },
        "until": {
          "description": "Exclusive end, or no end for a persistent Policy.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Window"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional allowed local-time window."
        }
      },
      "required": [
        "trigger",
        "notBefore",
        "jitterSeconds"
      ],
      "type": "object"
    },
    "ScriptRisk": {
      "enum": [
        1,
        2
      ],
      "type": "integer"
    },
    "SelfService": {
      "additionalProperties": false,
      "description": "Policy-owned self-service configuration. Missing input defaults are normalized by CAS.",
      "properties": {
        "allowAi": {
          "default": null,
          "description": "Defaults only at first configuration; normalized stored values are always present.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "category": {
          "description": "Presentation category, independent of Scope.",
          "type": "string"
        },
        "description": {
          "description": "Intended purpose.",
          "type": "string"
        },
        "displayName": {
          "description": "Display name in the authorized directory.",
          "type": "string"
        },
        "keywords": {
          "description": "Bounded search terms.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prerequisites": {
          "description": "Preconditions shown before invocation.",
          "type": "string"
        },
        "published": {
          "description": "Whether new self-service calls are accepted.",
          "type": "boolean"
        },
        "riskLevel": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptRisk"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to confirmation at first configuration; only levels one and two are legal."
        },
        "sideEffects": {
          "description": "Expected side effects shown before invocation.",
          "type": "string"
        }
      },
      "required": [
        "published",
        "displayName",
        "description",
        "prerequisites",
        "sideEffects",
        "category",
        "keywords"
      ],
      "type": "object"
    },
    "SoftwareDelivery": {
      "description": "Explicit delivery authority for the native behaviors in a software dependency closure.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Concrete installers consume approved task content directly.",
          "properties": {
            "kind": {
              "const": "direct",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native package managers consume already published immutable snapshots from this output source.",
          "properties": {
            "kind": {
              "const": "native",
              "type": "string"
            },
            "ring": {
              "$ref": "#/$defs/SoftwareDeliveryRing",
              "description": "Exact enterprise publication environment."
            },
            "source": {
              "description": "Exact configured logical output source; imported provenance remains separate.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source",
            "ring"
          ],
          "type": "object"
        }
      ]
    },
    "SoftwareDeliveryRing": {
      "description": "Explicit software publication environment selected by the deployment author.",
      "oneOf": [
        {
          "const": "test",
          "description": "Test publication.",
          "type": "string"
        },
        {
          "const": "pilot",
          "description": "Pilot publication.",
          "type": "string"
        },
        {
          "const": "production",
          "description": "Production publication.",
          "type": "string"
        }
      ]
    },
    "SoftwareIntent": {
      "description": "Desired software assignment behavior.",
      "oneOf": [
        {
          "const": "required_install",
          "description": "Enforce the approved software version.",
          "type": "string"
        },
        {
          "const": "available_install",
          "description": "Permit an authorized device or user to request installation.",
          "type": "string"
        },
        {
          "const": "explicit_uninstall",
          "description": "Explicitly request removal by a supporting definition.",
          "type": "string"
        }
      ]
    },
    "SoftwareResourceBinding": {
      "additionalProperties": false,
      "description": "Exact software variants belonging to a single immutable resource version.",
      "properties": {
        "id": {
          "description": "Logical resource identity.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/SoftwareResourceKind",
          "description": "Closed software resource discriminator."
        },
        "variants": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Exact variant for each supported platform and architecture.",
          "type": "object"
        },
        "version": {
          "description": "Immutable resource version.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version",
        "variants"
      ],
      "type": "object"
    },
    "SoftwareResourceKind": {
      "description": "Closed resource kind for software bindings.",
      "oneOf": [
        {
          "const": "software",
          "description": "Enterprise software.",
          "type": "string"
        }
      ]
    },
    "SoftwareRollout": {
      "additionalProperties": false,
      "description": "Time-driven rollout; success rate is an optional additional gate.",
      "properties": {
        "stages": {
          "description": "Ordered stage scopes and opening times.",
          "items": {
            "$ref": "#/$defs/SoftwareRolloutStage"
          },
          "type": "array"
        }
      },
      "required": [
        "stages"
      ],
      "type": "object"
    },
    "SoftwareRolloutStage": {
      "additionalProperties": false,
      "description": "One administrator-selected stage.",
      "properties": {
        "minimumVerifiedPercent": {
          "description": "Optional verified-success threshold for the preceding stage.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "opensAt": {
          "description": "UTC Unix timestamp for automatic opening.",
          "format": "int64",
          "type": "integer"
        },
        "scope": {
          "description": "Scope that becomes eligible at the opening time.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "opensAt"
      ],
      "type": "object"
    },
    "Trigger": {
      "description": "A closed event or calendar trigger evaluated against an explicit clock.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Only an explicit rerun trigger can admit this Policy.",
          "properties": {
            "kind": {
              "const": "manual",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A single Unix-second occurrence.",
          "properties": {
            "at": {
              "description": "Unix seconds of the occurrence.",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "once",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Fixed elapsed-second spacing from an anchor.",
          "properties": {
            "anchor": {
              "description": "Unix-second interval origin.",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "interval",
              "type": "string"
            },
            "seconds": {
              "description": "Interval length, from one minute through one year.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "anchor",
            "seconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One IANA-local weekday/time; gap skipped and fold resolved earlier.",
          "properties": {
            "kind": {
              "const": "weekly",
              "type": "string"
            },
            "minute": {
              "description": "Minute of the local day, from 0 through 1439.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            "weekday": {
              "description": "ISO weekday, Monday 1 through Sunday 7.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "zone": {
              "description": "IANA timezone name, or UTC.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "zone",
            "weekday",
            "minute"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An occurrence bound to a registration identity.",
          "properties": {
            "kind": {
              "const": "registration",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Authenticated Agent check-in, with a minimum interval.",
          "properties": {
            "kind": {
              "const": "check_in",
              "type": "string"
            },
            "minimumSeconds": {
              "description": "Minimum elapsed seconds between admitted check-ins.",
              "format": "uint32",
