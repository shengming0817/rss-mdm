        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "operationId": {
        "format": "uuid",
        "type": "string"
      },
      "saved": {
        "$ref": "#/$defs/Saved"
      }
    },
    "required": [
      "operationId",
      "saved"
    ],
    "title": "Receipt",
    "type": "object"
