{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Entry"
      }
    }
  },
  "required": [
    "items"
  ],
  "$defs": {
    "Action": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "href"
      ]
    },
    "Custody": {
      "type": "string",
      "enum": [
        "deployment_operator",
        "identity",
        "domain_service",
        "certificate_authority",
        "storage_provider",
        "device"
      ]
    },
    "Entry": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        },
        "appliedRevision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "configuredCount": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "custody": {
          "$ref": "#/$defs/Custody"
        },
        "desiredRevision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "lifecycle": {
          "$ref": "#/$defs/Lifecycle"
        },
        "owner": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "id",
        "scope",
        "owner",
        "custody",
        "lifecycle",
        "status",
        "actions"
      ]
    },
    "Lifecycle": {
      "description": "Applicable lifecycle, not a claim that any external qualification has been observed.",
      "type": "string",
      "enum": [
        "deployment_maintenance",
        "fixed_installation_identity",
        "fixed_ledger_key",
        "account_credential",
        "protection_key",
        "signing_trust",
        "external_certificate",
        "provider_credential",
        "business_configuration",
        "signed_package",
        "device_generated"
      ]
    },
    "Scope": {
      "type": "string",
      "enum": [
        "deployment",
        "platform",
        "tenant",
        "device"
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "unknown",
        "unconfigured",
        "configured",
        "loaded",
        "pending",
        "unavailable"
      ]
    }
  }
}
