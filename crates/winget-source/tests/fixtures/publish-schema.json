{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/components/schemas/ManifestSchema",
  "components": {
    "schemas": {
      "Architecture": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "x86",
              "x64",
              "arm",
              "arm64",
              "neutral"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "Author": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 2,
            "maxLength": 256
          },
          {
            "type": "null"
          }
        ]
      },
      "Capabilities": {
        "anyOf": [
          {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "Channel": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          {
            "type": "null"
          }
        ]
      },
      "Commands": {
        "anyOf": [
          {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "Copyright": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 3,
            "maxLength": 512
          },
          {
            "type": "null"
          }
        ]
      },
      "DefaultLocale": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LocaleSchema"
          },
          {
            "type": "object",
            "properties": {
              "Moniker": {
                "$ref": "#/components/schemas/Tag"
              }
            }
          }
        ],
        "required": [
          "Publisher",
          "PackageName",
          "License",
          "ShortDescription"
        ]
      },
      "Dependencies": {
        "type": "object",
        "properties": {
          "WindowsFeatures": {
            "anyOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "WindowsLibraries": {
            "anyOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "PackageDependencies": {
            "anyOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 16,
                "items": {
                  "$ref": "#/components/schemas/PackageDependency"
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "ExternalDependencies": {
            "anyOf": [
              {
                "type": "array",
                "uniqueItems": true,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Description": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 3,
            "maxLength": 10000
          },
          {
            "type": "null"
          }
        ]
      },
      "FileExtensions": {
        "anyOf": [
          {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[^\\\\/:\\*\\?\"<>\\|\\x01-\\x1f]+$",
              "maxLength": 64
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "InstallMode": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "interactive",
              "silent",
              "silentWithProgress"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "InstallModes": {
        "anyOf": [
          {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/InstallMode"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "Installer": {
        "type": "object",
        "properties": {
          "InstallerIdentifier": {
            "$ref": "#/components/schemas/InstallerIdentifier"
          },
          "InstallerSha256": {
            "$ref": "#/components/schemas/InstallerSha256"
          },
          "InstallerUrl": {
            "$ref": "#/components/schemas/Url"
          },
          "Architecture": {
            "$ref": "#/components/schemas/Architecture"
          },
          "InstallerLocale": {
            "$ref": "#/components/schemas/Locale"
          },
          "Platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "MinimumOSVersion": {
            "$ref": "#/components/schemas/MinimumOSVersion"
          },
          "InstallerType": {
            "$ref": "#/components/schemas/InstallerType"
          },
          "Scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "SignatureSha256": {
            "$ref": "#/components/schemas/SignatureSha256"
          },
          "InstallModes": {
            "$ref": "#/components/schemas/InstallModes"
          },
          "InstallerSwitches": {
            "$ref": "#/components/schemas/InstallerSwitches"
          },
          "InstallerSuccessCodes": {
            "$ref": "#/components/schemas/InstallerSuccessCodes"
          },
          "UpgradeBehavior": {
            "$ref": "#/components/schemas/UpgradeBehavior"
          },
          "Commands": {
            "$ref": "#/components/schemas/Commands"
          },
          "Protocols": {
            "$ref": "#/components/schemas/Protocols"
          },
          "FileExtensions": {
            "$ref": "#/components/schemas/FileExtensions"
          },
          "Dependencies": {
            "$ref": "#/components/schemas/Dependencies"
          },
          "PackageFamilyName": {
            "$ref": "#/components/schemas/PackageFamilyName"
          },
          "ProductCode": {
            "$ref": "#/components/schemas/ProductCode"
          },
          "Capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "RestrictedCapabilities": {
            "$ref": "#/components/schemas/RestrictedCapabilities"
          }
        },
        "required": [
          "Architecture",
          "InstallerUrl",
          "InstallerSha256",
          "InstallerType"
        ]
      },
      "InstallerIdentifier": {
        "type": "string",
        "maxLength": 128
      },
      "InstallerSchema": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Installer"
          }
        ]
      },
      "InstallerSha256": {
        "type": "string",
        "pattern": "^[A-Fa-f0-9]{64}$"
      },
      "InstallerSuccessCodes": {
        "anyOf": [
          {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 16,
            "items": {
              "type": "integer",
              "not": {
                "enum": [
                  0
                ]
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "InstallerSwitches": {
        "type": "object",
        "properties": {
          "Silent": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "SilentWithProgress": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "Interactive": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "InstallLocation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "Log": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "Upgrade": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "Custom": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "InstallerType": {
        "type": "string",
        "enum": [
          "msix",
          "msi",
          "appx",
          "exe",
          "zip",
          "inno",
          "nullsoft",
          "wix",
          "burn",
          "pwa"
        ]
      },
      "License": {
        "type": "string",
        "minLength": 3,
        "maxLength": 512
      },
      "Locale": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^([a-zA-Z]{2}|[iI]-[a-zA-Z]+|[xX]-[a-zA-Z]{1,8})(-[a-zA-Z]{1,8})*$",
            "maxLength": 20
          },
          {
            "type": "null"
          }
        ]
      },
      "LocaleSchema": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "PackageLocale": {
                "$ref": "#/components/schemas/Locale"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "Publisher": {
                "$ref": "#/components/schemas/Publisher"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "PublisherUrl": {
                "$ref": "#/components/schemas/Url"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "PublisherSupportUrl": {
                "$ref": "#/components/schemas/Url"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "PrivacyUrl": {
                "$ref": "#/components/schemas/Url"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "Author": {
                "$ref": "#/components/schemas/Author"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "PackageName": {
                "$ref": "#/components/schemas/PackageName"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "PackageUrl": {
                "$ref": "#/components/schemas/Url"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "License": {
                "$ref": "#/components/schemas/License"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "LicenseUrl": {
                "$ref": "#/components/schemas/Url"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "Copyright": {
                "$ref": "#/components/schemas/Copyright"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "CopyrightUrl": {
                "$ref": "#/components/schemas/Url"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "ShortDescription": {
                "$ref": "#/components/schemas/ShortDescription"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "Description": {
                "$ref": "#/components/schemas/Description"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "Tags": {
                "$ref": "#/components/schemas/Tags"
              }
            }
          }
        ],
        "required": [
          "PackageLocale"
        ]
      },
      "ManifestSchema": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PackageSchema"
          },
          {
            "type": "object",
            "properties": {
              "Versions": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/VersionSchema"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "Locales": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/OptionalLocale"
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "properties": {
                        "Installers": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/InstallerSchema"
                          },
                          "maxItems": 1024
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "MinimumOSVersion": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])(\\.(0|[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])){0,3}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "OptionalLocale": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LocaleSchema"
          }
        ]
      },
      "PackageDependency": {
        "type": "object",
        "properties": {
          "PackageIdentifier": {
            "$ref": "#/components/schemas/PackageIdentifier"
          },
          "MinimumVersion": {
            "$ref": "#/components/schemas/PackageVersion"
          }
        },
        "required": [
          "PackageIdentifier"
        ]
      },
      "PackageFamilyName": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Za-z0-9][-\\.A-Za-z0-9]+_[A-Za-z0-9]{13}$",
            "maxLength": 255
          },
          {
            "type": "null"
          }
        ]
      },
      "PackageIdentifier": {
        "type": "string",
        "pattern": "^[^\\.\\s\\\\/:\\*\\?\"<>\\|\\x01-\\x1f]{1,32}(\\.[^\\.\\s\\\\/:\\*\\?\"<>\\|\\x01-\\x1f]{1,32}){1,3}$",
        "maxLength": 128
      },
      "PackageName": {
        "type": "string",
        "minLength": 2,
        "maxLength": 256
      },
      "PackageSchema": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "PackageIdentifier": {
                "$ref": "#/components/schemas/PackageIdentifier"
              }
            }
          }
        ],
        "required": [
          "PackageIdentifier"
        ]
      },
      "PackageVersion": {
        "type": "string",
        "pattern": "^[^\\\\/:\\*\\?\"<>\\|\\x01-\\x1f]+$",
        "maxLength": 128
      },
      "Platform": {
        "anyOf": [
          {
            "type": "array",
            "items": {
              "type": "string",
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 2,
              "enum": [
                "Windows.Desktop",
                "Windows.Universal"
              ]
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "ProductCode": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          {
            "type": "null"
          }
        ]
      },
      "Protocols": {
        "anyOf": [
          {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[a-z][-a-z0-9\\.\\+]*$",
              "maxLength": 2048
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "Publisher": {
        "type": "string",
        "minLength": 2,
        "maxLength": 256
      },
      "RestrictedCapabilities": {
        "anyOf": [
          {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 1000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "Scope": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "user",
              "machine"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "ShortDescription": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256
      },
      "SignatureSha256": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      },
      "Tag": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\S+$",
            "minLength": 1,
            "maxLength": 40
          },
          {
            "type": "null"
          }
        ]
      },
      "Tags": {
        "anyOf": [
          {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 16,
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "UpgradeBehavior": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "install",
              "uninstallPrevious"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "Url": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^([Hh][Tt][Tt][Pp][Ss]?)://",
            "maxLength": 2048
          },
          {
            "type": "null"
          }
        ]
      },
      "VersionSchema": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "PackageVersion": {
                "$ref": "#/components/schemas/PackageVersion"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "DefaultLocale": {
                "$ref": "#/components/schemas/DefaultLocale"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "Channel": {
                "$ref": "#/components/schemas/Channel"
              }
            }
          }
        ],
        "required": [
          "PackageVersion",
          "DefaultLocale"
        ]
      }
    }
  }
}
