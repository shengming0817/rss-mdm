  "constraints": [
    [
      "asset_dispatch",
      "asset_dispatch_check",
      "c",
      "CHECK (((consumed >= 0) AND (watermark >= consumed)))",
      true
    ],
    [
      "asset_dispatch",
      "asset_dispatch_failure_check",
      "c",
      "CHECK ((failure = 'automation_suspended'::text))",
      true
    ],
    [
      "asset_dispatch",
      "asset_dispatch_phase_check",
      "c",
      "CHECK ((phase = ANY (ARRAY['groups'::text, 'devices'::text])))",
      true
    ],
    [
      "asset_dispatch",
      "asset_dispatch_pkey",
      "p",
      "PRIMARY KEY (tenant_id)",
      true
    ],
    [
      "asset_query_facets",
      "asset_query_facets_kind_check",
      "c",
      "CHECK ((kind = ANY (ARRAY['os_versions'::text, 'channels'::text, 'asset_states'::text])))",
      true
    ],
    [
      "asset_query_facets",
      "asset_query_facets_label_check",
      "c",
      "CHECK ((octet_length(label) <= 256))",
      true
    ],
    [
      "asset_query_facets",
      "asset_query_facets_pkey",
      "p",
      "PRIMARY KEY (tenant_id, run, kind, label)",
      true
    ],
    [
      "asset_query_facets",
      "asset_query_facets_tenant_id_run_fkey",
      "f",
      "FOREIGN KEY (tenant_id, run) REFERENCES mdm_management.asset_query_runs(tenant_id, id)",
      true
    ],
    [
      "asset_query_facets",
      "asset_query_facets_total_check",
      "c",
      "CHECK ((total > 0))",
      true
    ],
    [
      "asset_query_results",
      "asset_query_results_device_check",
      "c",
      "CHECK (((octet_length(device) >= 1) AND (octet_length(device) <= 256)))",
      true
    ],
    [
      "asset_query_results",
      "asset_query_results_digest_check",
      "c",
      "CHECK ((octet_length(digest) = 32))",
      true
    ],
    [
      "asset_query_results",
      "asset_query_results_document_check",
      "c",
      "CHECK ((octet_length(document) <= 1048576))",
      true
    ],
    [
      "asset_query_results",
      "asset_query_results_pkey",
      "p",
      "PRIMARY KEY (tenant_id, run, device)",
      true
    ],
    [
      "asset_query_results",
      "asset_query_results_sort_key_check",
      "c",
      "CHECK ((octet_length(sort_key) <= 1024))",
      true
    ],
    [
      "asset_query_results",
      "asset_query_results_tenant_id_run_fkey",
      "f",
      "FOREIGN KEY (tenant_id, run) REFERENCES mdm_management.asset_query_runs(tenant_id, id)",
      true
    ],
    [
      "asset_query_runs",
      "asset_query_runs_check",
      "c",
      "CHECK (((matched >= 0) AND (matched <= total)))",
      true
    ],
    [
      "asset_query_runs",
      "asset_query_runs_check1",
      "c",
      "CHECK (((unknown >= 0) AND (unknown <= total)))",
      true
    ],
    [
      "asset_query_runs",
      "asset_query_runs_pkey",
      "p",
      "PRIMARY KEY (tenant_id, id)",
      true
    ],
    [
      "asset_query_runs",
      "asset_query_runs_tenant_id_id_fkey",
      "f",
      "FOREIGN KEY (tenant_id, id) REFERENCES mdm_management.automation_jobs(tenant_id, id)",
      true
    ],
    [
      "asset_query_runs",
      "asset_query_runs_total_check",
      "c",
      "CHECK (((total >= 0) AND (total <= 1000000)))",
      true
    ],
    [
      "automation_jobs",
      "automation_jobs_authority_revision_check",
      "c",
      "CHECK ((authority_revision >= 0))",
      true
    ],
    [
      "automation_jobs",
      "automation_jobs_failure_check",
      "c",
