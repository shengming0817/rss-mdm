  "policyFacts": [
    "CREATE OR REPLACE FUNCTION mdm_commands.policy_facts(p_policy text)\n RETURNS TABLE(device text, version bigint, digest bytea, status text, write_status integer)\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'mdm_commands'\nAS $function$\nSELECT o.device,(o.request->'task'->>'version')::bigint AS version,r.digest,d.status,(SELECT a.status FROM mdm_commands.attempts a WHERE a.tenant_id=o.tenant_id AND a.operation=o.id AND a.phase='execute' ORDER BY ordinal DESC LIMIT 1) AS write_status FROM mdm_commands.operations o JOIN mdm_management.firewall_versions v ON v.tenant_id=o.tenant_id AND v.policy=o.request->'task'->>'policy' AND v.version=(o.request->'task'->>'version')::bigint JOIN mdm_management.firewall_resources r ON(r.tenant_id,r.resource,r.version)=(v.tenant_id,v.resource,v.resource_version) JOIN rss_device_command.commands d ON d.tenant_id=o.tenant_id AND d.command_id=o.id::text WHERE o.tenant_id=nullif(current_setting('rss.tenant_id',true),'')::uuid AND o.request->'task'->>'kind'='firewall' AND o.request->'task'->>'policy'=p_policy ORDER BY o.id;\n$function$\n",
    "mdm_owner",
    true,
    [
      "search_path=pg_catalog, mdm_commands"
    ]
  ]
