{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdm.group.changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "kind",
    "groupId",
    "operationId",
    "groupRevision",
    "memberVersion",
    "memberCount",
    "added",
    "removed",
    "ruleVersion",
    "authorityVersion"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "enum": [
        "created",
        "edited",
        "rule_changed",
        "members_changed",
        "deleted",
        "authority_changed"
      ]
    },
    "groupId": {
      "type": "string",
      "format": "uuid"
    },
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "groupRevision": {
      "type": "integer",
      "minimum": 1
    },
    "memberVersion": {
      "type": "integer",
      "minimum": 0
    },
    "memberCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "added": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "removed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "ruleVersion": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "authorityVersion": {
      "type": "integer",
      "minimum": 0
    }
  }
}
