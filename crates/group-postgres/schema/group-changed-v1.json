{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mdm.group.changed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "kind", "group_id", "operation_id", "group_revision", "member_version", "member_count", "added", "removed", "rule_version"],
  "properties": {
    "v": {"const": 1},
    "kind": {"enum": ["created", "edited", "rule_changed", "members_changed", "deleted"]},
    "group_id": {"type": "string", "format": "uuid"},
    "operation_id": {"type": "string", "format": "uuid"},
    "group_revision": {"type": "integer", "minimum": 1},
    "member_version": {"type": "integer", "minimum": 0},
    "member_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "added": {"type": "integer", "minimum": 0, "maximum": 10000},
    "removed": {"type": "integer", "minimum": 0, "maximum": 10000},
    "rule_version": {"type": ["string", "null"], "maxLength": 256}
  }
}
