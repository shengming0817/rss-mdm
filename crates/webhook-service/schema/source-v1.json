{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mdm.webhook.source.v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "value": {
          "$ref": "mdm.webhook.event.v1"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "compliance"
        },
        "value": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "tenant",
            "run",
            "previous",
            "rule",
            "ruleVersion",
            "occurredAt"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "tenant": {
              "type": "string",
              "format": "uuid"
            },
            "run": {
              "type": "string",
              "format": "uuid"
            },
            "previous": {
              "type": [
                "string",
                "null"
              ]
            },
            "rule": {
              "type": "string",
              "format": "uuid"
            },
            "ruleVersion": {
              "type": "integer",
              "minimum": 1
            },
            "occurredAt": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  ]
}
