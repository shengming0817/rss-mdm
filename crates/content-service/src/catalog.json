  "reference_guard": [
    "CREATE TRIGGER content_reference_ready BEFORE INSERT OR UPDATE ON mdm_resource.artifact_refs FOR EACH ROW EXECUTE FUNCTION mdm_content.reference_ready()",
    "CREATE OR REPLACE FUNCTION mdm_content.reference_ready()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n IF NOT NEW.archived AND EXISTS(SELECT 1 FROM mdm_content.manifests WHERE tenant_id=NEW.tenant_id AND sha256=NEW.sha256 AND state='deleting') THEN\n  RAISE EXCEPTION 'content is deleting' USING ERRCODE='40001';\n END IF;\n RETURN NEW;\nEND $function$\n",
    "O"
  ]
