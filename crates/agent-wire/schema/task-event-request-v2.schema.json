{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v2/task-event-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wireVersion",
    "operationId",
    "attemptId",
    "event"
  ],
  "properties": {
    "wireVersion": {
      "const": 2
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "attemptId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "received"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "start"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "cancelled"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "exitCode",
            "quality",
            "output",
            "diagnostics"
          ],
          "properties": {
            "kind": {
              "const": "result"
            },
            "exitCode": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              ]
            },
            "quality": {
              "enum": [
                "complete",
                "partial",
                "truncated",
                "failed"
              ]
            },
            "output": {},
            "diagnostics": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stdout",
                "stderr",
                "durationMs",
                "executedAt",
                "failure"
              ],
              "properties": {
                "stdout": {
                  "type": "string",
                  "maxLength": 16384,
                  "pattern": "^[^\\u0000]*$"
                },
                "stderr": {
                  "type": "string",
                  "maxLength": 16384,
                  "pattern": "^[^\\u0000]*$"
                },
                "durationMs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3600000
                },
                "executedAt": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "failure": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "enum": [
                        "launch_failed",
                        "timed_out",
                        "cancelled",
                        "non_zero_exit",
                        "output_limit",
                        "capture_failed"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "quality": {
                    "const": "complete"
                  }
                }
              },
              "then": {
                "properties": {
                  "exitCode": {
                    "const": 0
                  },
                  "diagnostics": {
                    "properties": {
                      "failure": {
                        "type": "null"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "diagnostics": {
                    "properties": {
                      "failure": {
                        "const": "non_zero_exit"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "exitCode": {
                    "type": "integer",
                    "not": {
                      "const": 0
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "diagnostics": {
                    "properties": {
                      "failure": {
                        "const": "launch_failed"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "exitCode": {
                    "type": "null"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "quality": {
                    "const": "failed"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostics": {
                    "properties": {
                      "failure": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "quality": {
                    "const": "truncated"
                  }
                }
              },
              "then": {
                "properties": {
                  "diagnostics": {
                    "properties": {
                      "failure": {
                        "const": "output_limit"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
