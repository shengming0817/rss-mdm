{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v5/registration-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wireVersion",
    "operationId",
    "enrollmentId",
    "password",
    "credential",
    "capabilities",
    "platform",
    "architecture"
  ],
  "properties": {
    "wireVersion": {
      "const": 5
    },
    "operationId": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "enrollmentId": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "password": {
      "$ref": "#/$defs/secret"
    },
    "credential": {
      "$ref": "#/$defs/secret"
    },
    "capabilities": {
      "enum": [
        [
          "inventory.collect.v5"
        ],
        [
          "inventory.collect.v5",
          "task.execute.v5"
        ],
        [
          "inventory.collect.v5",
          "software.execute.v5"
        ],
        [
          "inventory.collect.v5",
          "task.execute.v5",
          "software.execute.v5"
        ],
        [
          "inventory.collect.v5",
          "mdm.enrollment.v5"
        ],
        [
          "inventory.collect.v5",
          "task.execute.v5",
          "mdm.enrollment.v5"
        ],
        [
          "inventory.collect.v5",
          "software.execute.v5",
          "mdm.enrollment.v5"
        ],
        [
          "inventory.collect.v5",
          "task.execute.v5",
          "software.execute.v5",
          "mdm.enrollment.v5"
        ]
      ]
    },
    "platform": {
      "enum": [
        "windows",
        "macos"
      ]
    },
    "architecture": {
      "enum": [
        "x86_64",
        "aarch64"
      ]
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    }
  }
}
