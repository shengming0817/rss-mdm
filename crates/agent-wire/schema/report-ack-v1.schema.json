{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v1/report-ack.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["wireVersion", "reportId", "receivedAt", "intake"],
  "properties": {
    "wireVersion": { "const": 1 },
    "reportId": { "$ref": "#/$defs/nonNilUuid" },
    "receivedAt": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "intake": { "const": "durable" }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    }
  }
}
