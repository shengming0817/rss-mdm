            "attemptId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            },
            "permit": {
              "enum": [
                "offer",
                "start"
              ]
            },
            "expiresAt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "platform": {
              "enum": [
                "windows",
                "macos"
              ]
            },
            "architecture": {
              "enum": [
                "x86_64",
                "aarch64"
              ]
            },
            "organization": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              }
            },
            "entry": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "server"
                  ],
                  "properties": {
                    "kind": {
                      "const": "windows"
                    },
                    "server": {
                      "type": "string",
                      "maxLength": 2048,
                      "pattern": "^https://[^/@?#\\s]+/?$"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "url"
                  ],
                  "properties": {
                    "kind": {
                      "const": "macos"
                    },
                    "url": {
                      "type": "string",
                      "maxLength": 2048,
                      "pattern": "^https://[^/@?#\\s]+(?:/[^#\\s]*)?$"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$"
    }
  }
}
