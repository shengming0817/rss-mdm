{
  "$defs": {
    "PublicKey": {
      "additionalProperties": false,
      "description": "Public key only. The verifier validates the curve, point and Apple's derived key id.",
      "properties": {
        "crv": {
          "description": "JWK curve, P-256.",
          "type": "string"
        },
        "kty": {
          "description": "JWK key type, EC.",
          "type": "string"
        },
        "x": {
          "description": "Canonical unpadded Base64URL x coordinate.",
          "type": "string"
        },
        "y": {
          "description": "Canonical unpadded Base64URL y coordinate.",
          "type": "string"
        }
      },
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ],
      "type": "object"
    },
    "RegistrationTrust": {
      "description": "Server proof class; registration alone does not attest hardware or MFA.",
      "oneOf": [
        {
          "const": "mdm_bootstrap_pop",
          "description": "Device-authenticated bootstrap and key possession.",
          "type": "string"
        }
      ]
    },
    "SourceStatus": {
      "additionalProperties": false,
      "description": "Public recovery coordinates, never private key material.",
      "properties": {
        "encryptionKey": {
          "$ref": "#/$defs/PublicKey",
          "description": "Accepted encryption public key."
        },
        "id": {
          "description": "Stable source identity.",
          "format": "uuid",
          "type": "string"
        },
        "revoked": {
          "description": "Whether the source was revoked.",
          "type": "boolean"
        },
        "signingKey": {
          "$ref": "#/$defs/PublicKey",
          "description": "Accepted signing public key."
        },
        "version": {
          "description": "Accepted registration version.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "revoked",
        "signingKey",
        "encryptionKey"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only server observations. These never authorize a login.",
  "properties": {
    "applicationObserved": {
      "description": "Current MDM application inventory matches.",
      "type": "boolean"
    },
    "deviceRegistered": {
      "description": "Shared device registration is current.",
      "type": "boolean"
    },
    "deviceSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "Device key recovery coordinates."
    },
    "hardwareAttested": {
      "description": "Independent hardware attestation fact.",
      "type": "boolean"
    },
    "loginReady": {
      "description": "Server admission currently permits native login.",
      "type": "boolean"
    },
    "profileObserved": {
      "description": "Current MDM profile inventory matches.",
      "type": "boolean"
    },
    "registrationTrust": {
      "$ref": "#/$defs/RegistrationTrust",
      "description": "Actual registration proof class."
    },
    "userRegistered": {
      "description": "User registration is current.",
      "type": "boolean"
    },
    "userSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "User key recovery coordinates."
    }
  },
  "required": [
    "applicationObserved",
    "profileObserved",
    "deviceRegistered",
    "userRegistered",
    "loginReady",
    "registrationTrust",
    "hardwareAttested"
  ],
  "title": "Status",
  "type": "object",
  "$id": "https://rss.example/agent/platform-sso/v1/Status"
}
