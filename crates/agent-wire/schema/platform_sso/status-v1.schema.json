{
  "$defs": {
    "PasswordExchangeState": {
      "description": "A server-side Password exchange result, independent from OS application facts.",
      "oneOf": [
        {
          "const": "verifying",
          "description": "Nonce consumed; external verification has not settled locally.",
          "type": "string"
        },
        {
          "const": "succeeded",
          "description": "Server token issuance committed; no claim about local account or volume changes.",
          "type": "string"
        },
        {
          "const": "rejected",
          "description": "The submitted credentials or bound authority were rejected.",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "No native token was issued because the dependency was unavailable.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "An interrupted exchange has no confirmed local outcome before its deadline.",
          "type": "string"
        }
      ]
    },
    "PasswordExchangeStatus": {
      "additionalProperties": false,
      "description": "Bounded diagnostic coordinates; contains no password, proof or token.",
      "properties": {
        "attemptId": {
          "description": "Original server nonce identity.",
          "format": "uuid",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/PasswordExchangeState",
          "description": "Confirmed local state of this attempt."
        }
      },
      "required": [
        "attemptId",
        "state"
      ],
      "type": "object"
    },
    "PublicKey": {
      "additionalProperties": false,
      "description": "Public key only. The verifier validates the curve, point and Apple's derived key id.",
      "properties": {
        "crv": {
          "description": "JWK curve, P-256.",
          "type": "string"
        },
        "kty": {
          "description": "JWK key type, EC.",
          "type": "string"
        },
        "x": {
          "description": "Canonical unpadded Base64URL x coordinate.",
          "type": "string"
        },
        "y": {
          "description": "Canonical unpadded Base64URL y coordinate.",
          "type": "string"
        }
      },
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ],
      "type": "object"
    },
    "RegistrationTrust": {
      "description": "Server proof class; registration alone does not attest hardware or MFA.",
      "oneOf": [
        {
          "const": "mdm_bootstrap_pop",
          "description": "Device-authenticated bootstrap and key possession.",
          "type": "string"
        }
      ]
    },
    "SourceStatus": {
      "additionalProperties": false,
      "description": "Public recovery coordinates, never private key material.",
      "properties": {
        "encryptionKey": {
          "$ref": "#/$defs/PublicKey",
          "description": "Accepted encryption public key."
        },
        "id": {
          "description": "Stable source identity.",
          "format": "uuid",
          "type": "string"
        },
        "revoked": {
          "description": "Whether the source was revoked.",
          "type": "boolean"
        },
        "signingKey": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicKey"
            },
            {
              "type": "null"
            }
          ],
          "description": "Accepted device/SE signing key; absent for a Password user."
        },
        "version": {
          "description": "Accepted registration version.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "revoked",
        "encryptionKey"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only server observations. These never authorize a login.",
  "properties": {
    "applicationObserved": {
      "description": "Current MDM application inventory matches.",
      "type": "boolean"
    },
    "deviceRegistered": {
      "description": "Shared device registration is current.",
      "type": "boolean"
    },
    "deviceSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "Device key recovery coordinates."
    },
    "hardwareAttested": {
      "description": "Independent hardware attestation fact.",
      "type": "boolean"
    },
    "loginReady": {
      "description": "Server admission currently permits native login.",
      "type": "boolean"
    },
    "passwordExchange": {
      "anyOf": [
        {
          "$ref": "#/$defs/PasswordExchangeStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "Latest exchange for this exact registered user source; not a local password effect."
    },
    "profileObserved": {
      "description": "Current MDM profile inventory matches.",
      "type": "boolean"
    },
    "registrationTrust": {
      "$ref": "#/$defs/RegistrationTrust",
      "description": "Actual registration proof class."
    },
    "userRegistered": {
      "description": "User registration is current.",
      "type": "boolean"
    },
    "userSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceStatus"
        },
        {
          "type": "null"
        }
      ],
      "description": "User key recovery coordinates."
    }
  },
  "required": [
    "applicationObserved",
    "profileObserved",
    "deviceRegistered",
    "userRegistered",
    "loginReady",
    "registrationTrust",
    "hardwareAttested"
  ],
  "title": "Status",
  "type": "object",
  "$id": "https://rss.example/agent/platform-sso/v1/Status"
}
