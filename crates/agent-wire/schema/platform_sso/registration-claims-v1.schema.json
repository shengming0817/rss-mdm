{
  "$defs": {
    "DeviceId": {
      "format": "uuid",
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Signed registration claims. Signature verification and authority belong to consumers.",
  "properties": {
    "aud": {
      "description": "Tenant registration audience.",
      "type": "string"
    },
    "challengeId": {
      "description": "Exact bootstrap challenge.",
      "format": "uuid",
      "type": "string"
    },
    "encryptionKeyId": {
      "description": "SHA-256 of the X9.63 encryption key, standard Base64.",
      "type": "string"
    },
    "exp": {
      "description": "Expiry UTC seconds.",
      "format": "int64",
      "type": "integer"
    },
    "iat": {
      "description": "Issued UTC seconds.",
      "format": "int64",
      "type": "integer"
    },
    "iss": {
      "$ref": "#/$defs/DeviceId",
      "description": "Current Agent device identity."
    },
    "nonce": {
      "description": "Bootstrap nonce.",
      "type": "string"
    },
    "sourceId": {
      "description": "Exact source identity.",
      "format": "uuid",
      "type": "string"
    },
    "sourceVersion": {
      "description": "Exact source version.",
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "iss",
    "aud",
    "challengeId",
    "sourceId",
    "sourceVersion",
    "nonce",
    "encryptionKeyId",
    "iat",
    "exp"
  ],
  "title": "RegistrationClaims",
  "type": "object",
  "$id": "https://rss.example/agent/platform-sso/v1/RegistrationClaims"
}
