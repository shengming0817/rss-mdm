{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Revocation outcome; local system cleanup is a separate operation.",
  "properties": {
    "revoked": {
      "description": "Server revocation completed.",
      "type": "boolean"
    },
    "sourceId": {
      "description": "Revoked source.",
      "format": "uuid",
      "type": "string"
    },
    "sourceVersion": {
      "description": "Current source version.",
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "sourceId",
    "sourceVersion",
    "revoked"
  ],
  "title": "RevocationReceipt",
  "type": "object",
  "$id": "https://rss.example/agent/platform-sso/v1/RevocationReceipt"
}
