{
  "$defs": {
    "Endpoints": {
      "additionalProperties": false,
      "description": "Exact tenant-scoped HTTPS endpoints.",
      "properties": {
        "base": {
          "description": "Tenant protocol base URL.",
          "type": "string"
        },
        "issuer": {
          "description": "Expected native token issuer.",
          "type": "string"
        },
        "jwks": {
          "description": "Server verification-key endpoint.",
          "type": "string"
        },
        "nonce": {
          "description": "One-use server nonce endpoint.",
          "type": "string"
        },
        "token": {
          "description": "Native login endpoint.",
          "type": "string"
        }
      },
      "required": [
        "base",
        "issuer",
        "nonce",
        "token",
        "jwks"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Short-lived registration challenge. Never log or expose it to the renderer.",
  "properties": {
    "clientId": {
      "description": "Apple login client identifier.",
      "format": "uuid",
      "type": "string"
    },
    "endpoints": {
      "$ref": "#/$defs/Endpoints",
      "description": "Exact HTTPS tenant endpoints."
    },
    "expiresAt": {
      "description": "Absolute expiry in UTC seconds.",
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "description": "One-use challenge identity.",
      "format": "uuid",
      "type": "string"
    },
    "loginUserName": {
      "description": "Server-selected login subject, never the local account name.",
      "type": "string"
    },
    "nonce": {
      "description": "One-use server nonce.",
      "type": "string"
    },
    "sourceId": {
      "description": "Stable registered-source identity.",
      "format": "uuid",
      "type": "string"
    },
    "sourceVersion": {
      "description": "Version being registered.",
      "format": "int64",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "nonce",
    "expiresAt",
    "sourceId",
    "sourceVersion",
    "endpoints",
    "clientId",
    "loginUserName"
  ],
  "title": "BootstrapResponse",
  "type": "object",
  "$id": "https://rss.example/agent/platform-sso/v1/BootstrapResponse"
}
