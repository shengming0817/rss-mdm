{
  "$defs": {
    "SelfServiceCaller": {
      "description": "Origin attested by the authenticated system service, never taken from model arguments.",
      "oneOf": [
        {
          "const": "human",
          "description": "Interactive employee action.",
          "type": "string"
        },
        {
          "const": "ai",
          "description": "AI tool action forwarded by the system service.",
          "type": "string"
        }
      ]
    },
    "SelfServiceSubject": {
      "description": "Subject selected by the server's explicit Policy access basis.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Device credential plus effective device scope; no enterprise session.",
          "properties": {
            "kind": {
              "const": "device",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A live enterprise session matched by product authorization.",
          "properties": {
            "kind": {
              "const": "user",
              "type": "string"
            },
            "user": {
              "$ref": "#/$defs/SelfServiceUser",
              "description": "Authenticated enterprise coordinates, without a credential."
            }
          },
          "required": [
            "kind",
            "user"
          ],
          "type": "object"
        }
      ]
    },
    "SelfServiceUser": {
      "additionalProperties": false,
      "description": "Authenticated product user; contains no session credential.",
      "properties": {
        "instanceId": {
          "description": "Identity instance.",
          "format": "uuid",
          "type": "string"
        },
        "principalId": {
          "description": "Authenticated principal.",
          "format": "uuid",
          "type": "string"
        },
        "tenantId": {
          "description": "Product tenant.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "tenantId",
        "instanceId",
        "principalId"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Server decision covered by the same signature as all script execution inputs.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Ordinary scheduled Policy execution.",
      "properties": {
        "kind": {
          "const": "policy",
          "type": "string"
        },
        "policyId": {
          "description": "Policy identity.",
          "format": "uuid",
          "type": "string"
        },
        "policyVersion": {
          "description": "Immutable execution version.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "policyId",
        "policyVersion"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Existing Remote Operation execution.",
      "properties": {
        "kind": {
          "const": "remote_operation",
          "type": "string"
        },
        "operationId": {
          "description": "Operation identity.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "operationId"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Targeted Policy self-service invocation.",
      "properties": {
        "allowAi": {
          "description": "Effective AI switch.",
          "type": "boolean"
        },
        "confirmed": {
          "description": "Confirmation attested for this exact request by the service.",
          "type": "boolean"
        },
        "kind": {
          "const": "self_service",
          "type": "string"
        },
        "policyId": {
          "description": "Policy identity.",
          "format": "uuid",
          "type": "string"
        },
        "policyRevision": {
          "description": "Configuration revision approved at invocation.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "policyVersion": {
          "description": "Immutable execution version.",
          "format": "uuid",
          "type": "string"
        },
        "requestId": {
          "description": "Idempotency identity of the call.",
          "format": "uuid",
          "type": "string"
        },
        "riskLevel": {
          "description": "Closed risk level, one or two.",
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/SelfServiceCaller",
          "description": "Trusted service's caller classification."
        },
        "subject": {
          "$ref": "#/$defs/SelfServiceSubject",
          "description": "Real employee identity."
        }
      },
      "required": [
        "kind",
        "requestId",
        "subject",
        "source",
        "policyId",
        "policyRevision",
        "policyVersion",
        "allowAi",
        "riskLevel",
        "confirmed"
      ],
      "type": "object"
    }
  ],
  "title": "TaskAuthorization",
  "$id": "https://rss.example/mdm/agent/runtime/v1/payload/v1/task-authorization.schema.json"
}
