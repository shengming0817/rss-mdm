{
  "$defs": {
    "CollectedValue": {
      "description": "Definitive per-field outcome. Failed/missing attempts never delete a last-known fact.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Typed value validated against the frozen field version.",
          "properties": {
            "kind": {
              "const": "value",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Scalar"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit legal null.",
          "properties": {
            "kind": {
              "const": "null",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit removal of this source's field; never inferred from failure.",
          "properties": {
            "kind": {
              "const": "deleted",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Collector explicitly cannot provide this field.",
          "properties": {
            "kind": {
              "const": "unsupported",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "CollectionDefinition": {
      "additionalProperties": false,
      "description": "Frozen source and field definitions for one published collector version.\nConstructing this value validates structure; the caller still owns tenant/device authorization.",
      "properties": {
        "dataset": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDefinition"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/Source",
          "not": {
            "const": "manual"
          }
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "version",
        "source",
        "fields"
      ],
      "type": "object"
    },
    "FailureCode": {
      "description": "Closed collection failure categories; raw diagnostics are never transported.",
      "oneOf": [
        {
          "const": "permissionDenied",
          "description": "Collector lacked operating-system permission.",
          "type": "string"
        },
        {
          "const": "temporarilyUnavailable",
          "description": "A retryable dependency was unavailable.",
          "type": "string"
        },
        {
          "const": "collectionFailed",
          "description": "Collection failed without a more specific safe category.",
          "type": "string"
        }
      ]
    },
    "FieldDefinition": {
      "additionalProperties": false,
      "description": "A published field version. No time-based expiry and no execution permission.",
      "properties": {
        "itemKey": {
          "description": "Optional stable item-key property for a structured inventory list.",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "$ref": "#/$defs/FieldKey",
          "description": "Stable field identity.",
          "maxLength": 128,
          "pattern": "^(device|custom|channel)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "manual": {
          "description": "Whether management assignment is permitted.",
          "type": "boolean"
        },
        "nullable": {
          "description": "Accept explicit null as distinct from deletion.",
          "type": "boolean"
        },
        "platforms": {
          "description": "Supported platforms.",
          "items": {
            "$ref": "#/$defs/Platform"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "searchable": {
          "description": "Whether this field participates in conditions/search.",
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "description": "Read/filter visibility classification."
        },
        "sources": {
          "additionalProperties": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "description": "Allowed sources with priority; lower numbers win, equal numbers require consensus.",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/Source"
          },
          "type": "object"
        },
        "unit": {
          "description": "Exact optional unit; no implicit conversion.",
          "maxLength": 64,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "valueType": {
          "$ref": "#/$defs/ValueType",
          "description": "Exact bounded type."
        },
        "version": {
          "description": "Monotonic published version.",
          "format": "uint64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "version",
        "valueType",
        "nullable",
        "manual",
        "sources",
        "platforms",
        "sensitivity",
        "unit",
        "searchable",
        "itemKey"
      ],
      "type": "object"
    },
    "FieldKey": {
      "description": "Bounded protocol field identity; parsing grants no catalog or source authority.",
      "maxLength": 128,
      "pattern": "^(device|custom|channel)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "type": "string"
    },
    "FieldValue": {
      "additionalProperties": false,
      "description": "One field and its explicit outcome.",
      "properties": {
        "field": {
          "$ref": "#/$defs/FieldKey",
          "description": "Field identity."
        },
        "value": {
          "$ref": "#/$defs/CollectedValue",
          "description": "Collected outcome."
        }
      },
      "required": [
        "field",
        "value"
      ],
      "type": "object"
    },
    "Platform": {
      "description": "Platform applicable to a field or collector.",
      "oneOf": [
        {
          "const": "windows",
          "description": "Windows.",
          "type": "string"
        },
        {
          "const": "macos",
          "description": "macOS.",
          "type": "string"
        }
      ]
    },
    "ReportBody": {
      "description": "Closed V1 report body.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "snapshot",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/FieldValue"
              },
              "maxItems": 128,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "partial",
              "type": "string"
            },
            "values": {
              "items": {
                "$ref": "#/$defs/FieldValue"
              },
              "maxItems": 128,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/FailureCode"
            },
            "kind": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "type": "object"
        }
      ]
    },
    "Scalar": {
      "description": "Explicitly typed asset scalar. Times are UTC Unix seconds, never validity windows.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Nonblank bounded text.",
          "properties": {
            "kind": {
              "const": "string",
              "type": "string"
            },
            "value": {
              "maxLength": 65536,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Signed integer.",
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite numeric observation.",
          "properties": {
            "kind": {
              "const": "number",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered bounded collection.",
          "properties": {
            "kind": {
              "const": "array",
              "type": "string"
            },
            "value": {
              "items": {
                "$ref": "#/$defs/Scalar"
              },
              "maxItems": 100000,
              "type": "array"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Declared structured attributes.",
          "properties": {
            "kind": {
              "const": "object",
              "type": "string"
            },
            "value": {
              "additionalProperties": {
                "$ref": "#/$defs/Scalar"
              },
              "maxProperties": 64,
              "propertyNames": {
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Boolean value, including false.",
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "UTC Unix seconds.",
          "properties": {
            "kind": {
              "const": "time",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Sensitivity": {
      "description": "Field visibility class, enforced by the product authorization boundary.",
      "oneOf": [
        {
          "const": "standard",
          "description": "Ordinary inventory.",
          "type": "string"
        },
        {
          "const": "sensitive",
          "description": "Requires the sensitive inventory permission.",
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "All allowed asset sources. Serialized as their canonical stable identifier.",
      "oneOf": [
        {
          "const": "agent.script",
          "description": "Controlled collection script evidence.",
          "type": "string"
        },
        {
          "const": "agent.osquery",
          "description": "Published SQL template evidence.",
          "type": "string"
        },
        {
          "const": "mdm.apple",
          "description": "Apple MDM evidence.",
          "type": "string"
        },
        {
          "const": "agent.builtin",
          "description": "Built-in agent evidence.",
          "type": "string"
        },
        {
          "const": "manual",
          "description": "Administrator assignment.",
          "type": "string"
        },
        {
          "const": "mdm.windows",
          "description": "Windows MDM evidence.",
          "type": "string"
        }
      ]
    },
    "ValueType": {
      "description": "Closed structural schema for one field; every property is explicit and required.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Bounded text; empty text is a legitimate value when allowed.",
          "properties": {
            "allowEmpty": {
              "description": "Whether empty text is allowed.",
              "type": "boolean"
            },
            "kind": {
              "const": "string",
              "type": "string"
            },
            "maxLength": {
              "description": "Character budget.",
              "format": "uint32",
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "maxLength",
            "allowEmpty"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Closed string vocabulary.",
          "properties": {
            "kind": {
              "const": "enum",
              "type": "string"
            },
            "values": {
              "description": "Permitted nonempty values.",
              "items": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "maxItems": 128,
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Signed 64-bit integer.",
          "properties": {
            "kind": {
              "const": "integer",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Finite numeric value.",
          "properties": {
            "kind": {
              "const": "number",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Boolean.",
          "properties": {
            "kind": {
              "const": "boolean",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "UTC Unix seconds.",
          "properties": {
            "kind": {
              "const": "time",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Ordered values sharing one schema.",
          "properties": {
            "items": {
              "$ref": "#/$defs/ValueType",
              "description": "Element schema."
            },
            "kind": {
              "const": "array",
              "type": "string"
            },
            "maxItems": {
              "description": "Maximum number of values.",
              "format": "uint32",
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "items",
            "maxItems"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Closed properties; undeclared and absent properties are rejected.",
          "properties": {
            "kind": {
              "const": "object",
              "type": "string"
            },
            "properties": {
              "additionalProperties": {
                "$ref": "#/$defs/ValueType"
              },
              "description": "Property schema by literal name.",
              "maxProperties": 64,
              "minProperties": 1,
              "propertyNames": {
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "type": "object"
            }
          },
          "required": [
            "kind",
            "properties"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict V1 inventory report.",
  "properties": {
    "body": {
      "$ref": "#/$defs/ReportBody"
    },
    "collection": {
      "$ref": "#/$defs/CollectionDefinition"
    },
    "observedAt": {
      "format": "int64",
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "reportId": {
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "sequence": {
      "format": "uint64",
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "wireVersion": {
      "const": 1
    }
  },
  "required": [
    "wireVersion",
    "reportId",
    "sequence",
    "observedAt",
    "collection",
    "body"
  ],
  "title": "ReportRequest",
  "type": "object",
  "$id": "https://rss.example/mdm/agent/runtime/v1/payload/v1/report-request.schema.json"
}
