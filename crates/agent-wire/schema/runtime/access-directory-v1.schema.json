{
  "$defs": {
    "AccessAccount": {
      "description": "Stable local account identity, never a display name or a transient Unix UID.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Windows account, with provenance reported by the authenticated native session.",
          "properties": {
            "authority": {
              "$ref": "#/$defs/AccessWindowsAuthority",
              "description": "Local machine, AD domain or Entra tenant authority; never inferred from a name."
            },
            "platform": {
              "const": "windows",
              "type": "string"
            },
            "sid": {
              "description": "SID returned by the native account operation.",
              "type": "string"
            }
          },
          "required": [
            "platform",
            "sid",
            "authority"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "macOS local directory account.",
          "properties": {
            "generatedUid": {
              "description": "Persistent directory identity, distinct from numeric UID.",
              "format": "uuid",
              "type": "string"
            },
            "platform": {
              "const": "macos",
              "type": "string"
            }
          },
          "required": [
            "platform",
            "generatedUid"
          ],
          "type": "object"
        }
      ]
    },
    "AccessAccountDisposition": {
      "description": "Explicit OS account handling when removing RSS integration. Data is always retained.",
      "oneOf": [
        {
          "const": "keep",
          "description": "Preserve the account's enabled state and privilege.",
          "type": "string"
        },
        {
          "const": "disable",
          "description": "Disable interactive login without deleting the account.",
          "type": "string"
        },
        {
          "const": "standard",
          "description": "Remove administrator privilege while preserving login.",
          "type": "string"
        }
      ]
    },
    "AccessBindingStatus": {
      "additionalProperties": false,
      "description": "Safe employee-facing binding projection. This is not a login credential.",
      "properties": {
        "account": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessAccount"
            },
            {
              "type": "null"
            }
          ],
          "description": "Actual native account, if known."
        },
        "accountDisposition": {
          "$ref": "#/$defs/AccessAccountDisposition",
          "description": "Desired account handling on revocation."
        },
        "appliedRevision": {
          "description": "Last confirmed applied revision.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "bindingGeneration": {
          "description": "Association generation.",
          "format": "int64",
          "type": "integer"
        },
        "configuration": {
          "$ref": "#/$defs/AccessConfiguration",
          "description": "Desired configuration."
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessEffect"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native effect, not inferred from transport acknowledgement."
        },
        "factorGeneration": {
          "description": "Factor replacement generation.",
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "description": "Stable binding.",
          "format": "uuid",
          "type": "string"
        },
        "receivedRevision": {
          "description": "Last received desired revision.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "revision": {
          "description": "Desired revision.",
          "format": "int64",
          "type": "integer"
        },
        "revoked": {
          "description": "Whether this association is revoked on the server.",
          "type": "boolean"
        }
      },
      "required": [
        "accountDisposition",
        "id",
        "bindingGeneration",
        "factorGeneration",
        "revision",
        "revoked",
        "configuration"
      ],
      "type": "object"
    },
    "AccessConfiguration": {
      "additionalProperties": false,
      "description": "Common product configuration; Apple protocol payloads remain with the Apple owner.",
      "properties": {
        "enabled": {
          "description": "Enable the platform's RSS login integration.",
          "type": "boolean"
        },
        "mac": {
          "anyOf": [
            {
              "$ref": "#/$defs/LoginConfiguration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Device-wide Mac profile settings; absence excludes Mac integration from this policy."
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessRole"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit role convergence; null preserves existing role, new accounts default standard."
        },
        "selfEnrollment": {
          "description": "Permit the first association to the currently authenticated interactive local account.",
          "type": "boolean"
        },
        "windows": {
          "$ref": "#/$defs/AccessWindowsConfiguration",
          "description": "Explicit admitted Windows account authorities."
        }
      },
      "required": [
        "windows",
        "selfEnrollment",
        "enabled"
      ],
      "type": "object"
    },
    "AccessEffect": {
      "description": "Effect receipt. Received/start ACKs are carried by the existing task protocol separately.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Native retirement observation; completion also requires credential removal.",
          "properties": {
            "account": {
              "$ref": "#/$defs/AccessAccount",
              "description": "Exact Entra account."
            },
            "disposition": {
              "$ref": "#/$defs/AccessAccountDisposition",
              "description": "Independently observed OS disposition."
            },
            "facts": {
              "$ref": "#/$defs/AccessWhfbFacts",
              "description": "Local observations, not directory revocation or a successful login."
            },
            "state": {
              "const": "whfb_retired",
              "type": "string"
            }
          },
          "required": [
            "state",
            "account",
            "disposition",
            "facts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The exact requested configuration has been durably installed and read back.",
          "properties": {
            "account": {
              "$ref": "#/$defs/AccessAccount",
              "description": "Identity actually changed or confirmed."
            },
            "mac": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AccessMacFacts"
                },
                {
                  "type": "null"
                }
              ],
              "description": "macOS-specific facts; required on macOS and absent on Windows."
            },
            "role": {
              "$ref": "#/$defs/AccessRole",
              "description": "Actual native privilege after the operation."
            },
            "state": {
              "const": "applied",
              "type": "string"
            },
            "windows": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AccessWindowsFacts"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Installed Windows factors and exact durable escrow coordinates."
            }
          },
          "required": [
            "state",
            "account",
            "role"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Integration removal and the requested OS disposition were independently read back.",
          "properties": {
            "disposition": {
              "$ref": "#/$defs/AccessAccountDisposition",
              "description": "Verified account handling; account data is retained."
            },
            "state": {
              "const": "unbound",
              "type": "string"
            }
          },
          "required": [
            "state",
            "disposition"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The device cannot yet establish the effect of the original attempt.",
          "properties": {
            "state": {
              "const": "unknown",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A known failure without claiming the requested state was installed.",
          "properties": {
            "reason": {
              "$ref": "#/$defs/AccessFailure",
              "description": "Bounded public failure reason."
            },
            "state": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "AccessFailure": {
      "description": "Closed native failure classes; never include command output or user credentials.",
      "oneOf": [
        {
          "const": "unsupported",
          "description": "The native integration is not installed or supported.",
          "type": "string"
        },
        {
          "const": "account_changed",
          "description": "The exact local identity or current login changed.",
          "type": "string"
        },
        {
          "const": "name_conflict",
          "description": "A requested name already belongs to a different account.",
          "type": "string"
        },
        {
          "const": "recovery_account_protected",
          "description": "An operation would remove the last administrator or recovery-capable account.",
          "type": "string"
        },
        {
          "const": "needs_user",
          "description": "User input is needed locally; no password is returned to the server.",
          "type": "string"
        },
        {
          "const": "native_failure",
          "description": "Native persistence or read-back failed.",
          "type": "string"
        }
      ]
    },
    "AccessMacFacts": {
      "additionalProperties": false,
      "description": "Apple account facts are separate from PSSO registration and Secure Enclave keys.",
      "properties": {
        "filevaultUnlock": {
          "$ref": "#/$defs/AccessObservation",
          "description": "Actual FileVault unlock eligibility, not merely the disk encryption setting."
        },
        "keychainSync": {
          "$ref": "#/$defs/AccessObservation",
          "description": "Native login keychain synchronization, independent of account password success."
        },
        "passwordSync": {
          "$ref": "#/$defs/AccessObservation",
          "description": "Native account password synchronization, never inferred from the IdP exchange."
        },
        "secureToken": {
          "$ref": "#/$defs/AccessObservation",
          "description": "The account's Secure Token status, not Bootstrap Token custody."
        },
        "volumeOwner": {
          "$ref": "#/$defs/AccessObservation",
          "description": "Apple silicon volume ownership."
        }
      },
      "required": [
        "passwordSync",
        "keychainSync",
        "secureToken",
        "volumeOwner",
        "filevaultUnlock"
      ],
      "type": "object"
    },
    "AccessObservation": {
      "description": "One independent native capability observation, never inferred from transport success.",
      "oneOf": [
        {
          "const": "present",
          "description": "The capability has been verified for this exact local account.",
          "type": "string"
        },
        {
          "const": "absent",
          "description": "Native inspection verified the capability is absent.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Inspection could not establish the capability.",
          "type": "string"
        },
        {
          "const": "needs_administrator",
          "description": "A qualified local administrator must authorize the operation.",
          "type": "string"
        }
      ]
    },
    "AccessPolicyOption": {
      "additionalProperties": false,
      "description": "One currently eligible first-enrollment policy.",
      "properties": {
        "configuration": {
          "$ref": "#/$defs/AccessConfiguration",
          "description": "Safe configuration preview; begin rechecks current authority."
        },
        "policy": {
          "description": "Policy identity used by begin.",
          "format": "uuid",
          "type": "string"
        },
        "version": {
          "description": "Current published policy version.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "policy",
        "version",
        "configuration"
      ],
      "type": "object"
    },
    "AccessRole": {
      "description": "Requested account privilege. Absence preserves an existing account's privilege.",
      "oneOf": [
        {
          "const": "standard",
          "description": "Ordinary local user.",
          "type": "string"
        },
        {
          "const": "administrator",
          "description": "Local administrator, requiring explicit RSS device-account authorization.",
          "type": "string"
        }
      ]
    },
    "AccessWhfbFacts": {
      "additionalProperties": false,
      "description": "Native account-scoped observations, never a claim that LogonUI authenticated a user.",
      "properties": {
        "factorGeneration": {
          "description": "Exact requested credential generation.",
          "format": "int64",
          "type": "integer"
        },
        "hardwareKey": {
          "$ref": "#/$defs/AccessObservation",
          "description": "TPM-backed native credential, independent of policy configuration."
        },
        "keyId": {
          "description": "Current native key identity; no private or secret material.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "objectId": {
          "description": "Current Entra account.",
          "format": "uuid",
          "type": "string"
        },
        "observedAt": {
          "description": "UTC seconds at native observation.",
          "format": "int64",
          "type": "integer"
        },
        "policy": {
          "$ref": "#/$defs/AccessObservation",
          "description": "Effective policy after conflict checks and native readback."
        },
        "registration": {
          "$ref": "#/$defs/AccessObservation",
          "description": "Current user's native registration observation."
        },
        "tenantId": {
          "description": "Entra authority observed on this device.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "factorGeneration",
        "tenantId",
        "objectId",
        "policy",
        "registration",
        "hardwareKey",
        "observedAt"
      ],
      "type": "object"
    },
    "AccessWindowsAuthority": {
      "description": "Stable Windows identity authority. Display names and email addresses are excluded.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The current registered computer's SAM database.",
          "properties": {
            "kind": {
              "const": "local",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Native directory domain SID, distinct from the user's account SID.",
          "properties": {
            "domainSid": {
              "description": "SID of the native AD domain, excluding the user's RID.",
              "type": "string"
            },
            "kind": {
              "const": "active_directory",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "domainSid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Stable directory identifiers from the native Entra account.",
          "properties": {
            "kind": {
              "const": "entra",
              "type": "string"
            },
            "objectId": {
              "description": "Immutable user object identifier within that tenant.",
              "format": "uuid",
              "type": "string"
            },
            "tenantId": {
              "description": "Tenant that owns the native directory account.",
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "tenantId",
            "objectId"
          ],
          "type": "object"
        }
      ]
    },
    "AccessWindowsConfiguration": {
      "description": "Current Windows policy, with no implicit fallback between authentication mechanisms.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "This policy does not target Windows.",
          "properties": {
            "kind": {
              "const": "disabled",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Password plus the RSS offline factor.",
          "properties": {
            "accounts": {
              "description": "Explicit admitted account authorities.",
              "items": {
                "$ref": "#/$defs/AccessWindowsKind"
              },
              "type": "array"
            },
            "kind": {
              "const": "rss_factor",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "accounts"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Pure Entra join, TPM 2.0 and PIN; Windows owns enrollment and authentication.",
          "properties": {
            "kind": {
              "const": "whfb",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "AccessWindowsFacts": {
      "description": "Mechanism-specific observations; an RSS escrow receipt cannot prove Hello registration.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "RSS factor and durable recovery custody.",
          "properties": {
            "factorGeneration": {
              "description": "Exact installed factor generation.",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "rss_factor",
              "type": "string"
            },
            "recovery": {
              "$ref": "#/$defs/CredentialReceipt",
              "description": "Exact recovery material retained on this endpoint."
            }
          },
          "required": [
            "kind",
            "factorGeneration",
            "recovery"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Windows-owned registration and configuration.",
          "properties": {
            "factorGeneration": {
              "description": "Exact requested credential generation.",
              "format": "int64",
              "type": "integer"
            },
            "hardwareKey": {
              "$ref": "#/$defs/AccessObservation",
              "description": "TPM-backed native credential, independent of policy configuration."
            },
            "keyId": {
              "description": "Current native key identity; no private or secret material.",
              "format": "uuid",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "whfb",
              "type": "string"
            },
            "objectId": {
              "description": "Current Entra account.",
              "format": "uuid",
              "type": "string"
            },
            "observedAt": {
              "description": "UTC seconds at native observation.",
              "format": "int64",
              "type": "integer"
            },
            "policy": {
              "$ref": "#/$defs/AccessObservation",
              "description": "Effective policy after conflict checks and native readback."
            },
            "registration": {
              "$ref": "#/$defs/AccessObservation",
              "description": "Current user's native registration observation."
            },
            "tenantId": {
              "description": "Entra authority observed on this device.",
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "factorGeneration",
            "tenantId",
            "objectId",
            "policy",
            "registration",
            "hardwareKey",
            "observedAt"
          ],
          "type": "object"
        }
      ]
    },
    "AccessWindowsKind": {
      "description": "Windows account classes admitted by the selected policy.",
      "oneOf": [
        {
          "const": "local",
          "description": "Local SAM account.",
          "type": "string"
        },
        {
          "const": "active_directory",
          "description": "AD domain account.",
          "type": "string"
        },
        {
          "const": "entra",
          "description": "Entra directory account.",
          "type": "string"
        }
      ]
    },
    "AuthenticationMode": {
      "description": "Device-wide login mode; every user on one Mac consumes the same system profile.",
      "oneOf": [
        {
          "const": "secure_enclave",
          "description": "Existing Secure Enclave user-key protocol.",
          "type": "string"
        },
        {
          "const": "password",
          "description": "Device-signed Apple Password request, verified by the selected password authority.",
          "type": "string"
        }
      ]
    },
    "CredentialReceipt": {
      "additionalProperties": false,
      "description": "Durable escrow coordinates returned only for the exact accepted task event.",
      "properties": {
        "material": {
          "description": "Server-assigned entry identity.",
          "format": "uuid",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/CredentialSubject",
          "description": "Exact material subject."
        },
        "version": {
          "description": "Immutable material version.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "subject",
        "material",
        "version"
      ],
      "type": "object"
    },
    "CredentialSubject": {
      "description": "An exact Windows object, never an account display name or drive letter.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "RSS additional-factor recovery material, separate from local-account passwords.",
          "properties": {
            "binding": {
              "description": "Stable Device Access association.",
              "format": "uuid",
              "type": "string"
            },
            "bindingGeneration": {
              "description": "Exact association generation.",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "rss_login",
              "type": "string"
            },
            "sid": {
              "description": "Stable local account SID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "binding",
            "bindingGeneration",
            "sid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Numerical recovery protector on a stable volume.",
          "properties": {
            "kind": {
              "const": "bitlocker",
              "type": "string"
            },
            "protector": {
              "description": "Recovery protector identity.",
              "format": "uuid",
              "type": "string"
            },
            "volume": {
              "description": "Stable WMI volume DeviceID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "volume",
            "protector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit RSS-managed local account.",
          "properties": {
            "kind": {
              "const": "local_administrator",
              "type": "string"
            },
            "sid": {
              "description": "Stable Windows account SID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sid"
          ],
          "type": "object"
        }
      ]
    },
    "LoginConfiguration": {
      "additionalProperties": false,
      "description": "Business configuration compiled into one device-wide System profile. No deployment secrets.",
      "properties": {
        "authentication": {
          "$ref": "#/$defs/AuthenticationMode",
          "description": "Chosen native authentication method."
        },
        "filevault": {
          "$ref": "#/$defs/LoginPolicy",
          "description": "Policy for Apple silicon FileVault unlock."
        },
        "login": {
          "$ref": "#/$defs/LoginPolicy",
          "description": "Policy for the login window."
        },
        "maintenanceAccounts": {
          "description": "Exact local maintenance account short names excluded from platform login policy.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "offlineGraceSeconds": {
          "description": "Explicit offline allowance, in seconds; never synthesized by the server.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "passwordProvider": {
          "description": "Configured password provider identity; required only in Password mode.",
          "format": "uuid",
          "type": [
            "string",
            "null"
          ]
        },
        "registrationGraceSeconds": {
          "description": "Explicit allowance for unregistered accounts, in seconds.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unlock": {
          "$ref": "#/$defs/LoginPolicy",
          "description": "Policy for screen unlock."
        }
      },
      "required": [
        "authentication",
        "login",
        "unlock",
        "filevault",
        "maintenanceAccounts"
      ],
      "type": "object"
    },
    "LoginPolicy": {
      "description": "An explicit platform login policy, independent for login, unlock and FileVault.",
      "oneOf": [
        {
          "const": "local",
          "description": "Preserve native local login; do not emit an enforcing platform policy.",
          "type": "string"
        },
        {
          "const": "attempt",
          "description": "Try the configured password authority with Apple's offline behavior.",
          "type": "string"
        },
        {
          "const": "require",
          "description": "Require the configured authority; grace periods must be explicitly selected.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bounded employee discovery; cursors advance scanned rows, including ineligible policies.",
  "properties": {
    "bindings": {
      "description": "This authenticated person's bindings in the current device registration.",
      "items": {
        "$ref": "#/$defs/AccessBindingStatus"
      },
      "type": "array"
    },
    "nextCursor": {
