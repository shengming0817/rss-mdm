{
  "$defs": {
    "CapabilitySelector": {
      "description": "Explicit exact address in the authenticated tenant's Policy namespace.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Canonical Policy identity.",
          "properties": {
            "id": {
              "description": "Object ID.",
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "id",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Server-generated tool name.",
          "properties": {
            "kind": {
              "const": "tool_name",
              "type": "string"
            },
            "name": {
              "description": "Complete canonical name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Administrator-controlled unique alias.",
          "properties": {
            "alias": {
              "$ref": "#/$defs/PolicyAlias",
              "description": "Canonical tenant-local alias."
            },
            "kind": {
              "const": "alias",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "alias"
          ],
          "type": "object"
        }
      ]
    },
    "PolicyAlias": {
      "description": "Tenant-local canonical Policy alias.",
      "type": "string"
    },
    "SelfServiceCaller": {
      "description": "Origin attested by the authenticated system service, never taken from model arguments.",
      "oneOf": [
        {
          "const": "human",
          "description": "Interactive employee action.",
          "type": "string"
        },
        {
          "const": "ai",
          "description": "AI tool action forwarded by the system service.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact self-service discovery, authenticated like the directory.",
  "properties": {
    "selector": {
      "$ref": "#/$defs/CapabilitySelector",
      "description": "One explicit address."
    },
    "source": {
      "$ref": "#/$defs/SelfServiceCaller",
      "description": "Trusted caller classification."
    }
  },
  "required": [
    "source",
    "selector"
  ],
  "title": "SelfServiceResolve",
  "type": "object",
  "$id": "https://rss.example/mdm/agent/runtime/v1/payload/v1/self-service-resolve.schema.json"
}
