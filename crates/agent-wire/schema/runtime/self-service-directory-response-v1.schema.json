{
  "$defs": {
    "ExecutionIdentity": {
      "description": "Required operating-system execution identity.",
      "oneOf": [
        {
          "const": "system",
          "description": "Service identity.",
          "type": "string"
        },
        {
          "const": "logged_in_user",
          "description": "Current logged-in user, without fallback.",
          "type": "string"
        }
      ]
    },
    "ScriptParameterSource": {
      "description": "Public source of one Resource-declared parameter.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Administrator literal.",
          "properties": {
            "kind": {
              "const": "fixed",
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "pattern": "^[^\\u0000]*$",
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "maximum": 9223372036854775807,
                  "minimum": -9223372036854775808,
                  "type": "integer"
                }
              ],
              "description": "Administrator-selected scalar checked against the Resource schema."
            }
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Required call-time input.",
          "properties": {
            "kind": {
              "const": "input",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "SelfServiceDirectoryItem": {
      "additionalProperties": false,
      "description": "One currently authorized script and its Resource-owned parameter schema.",
      "properties": {
        "policyId": {
          "description": "Logical Policy identity.",
          "format": "uuid",
          "type": "string"
        },
        "policyRevision": {
          "description": "Current configuration CAS revision.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "policyVersion": {
          "description": "Immutable execution version.",
          "format": "uuid",
          "type": "string"
        },
        "selfService": {
          "$ref": "#/$defs/SelfServiceMetadata",
          "description": "Normalized presentation and invocation settings."
        },
        "task": {
          "$ref": "#/$defs/SelfServiceTask",
          "description": "Closed task kind and the exact invocation interface."
        }
      },
      "required": [
        "policyId",
        "policyRevision",
        "policyVersion",
        "selfService",
        "task"
      ],
      "type": "object"
    },
    "SelfServiceMetadata": {
      "additionalProperties": false,
      "description": "Published presentation and invocation settings; values are normalized by Policy CAS.",
      "properties": {
        "allowAi": {
          "description": "Effective administrator AI switch.",
          "type": "boolean"
        },
        "category": {
          "description": "Presentation category.",
          "type": "string"
        },
        "description": {
          "description": "Intended purpose.",
          "type": "string"
        },
        "displayName": {
          "description": "Directory display name.",
          "type": "string"
        },
        "keywords": {
          "description": "Search terms.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "prerequisites": {
          "description": "Preconditions shown before invocation.",
          "type": "string"
        },
        "published": {
          "description": "Whether this script is published for self service.",
          "type": "boolean"
        },
        "riskLevel": {
          "description": "Effective risk level, one or two.",
          "enum": [
            1,
            2
          ],
          "type": "integer"
        },
        "sideEffects": {
          "description": "Expected effects shown before invocation.",
          "type": "string"
        }
      },
      "required": [
        "published",
        "displayName",
        "description",
        "prerequisites",
        "sideEffects",
        "category",
        "keywords",
        "allowAi",
        "riskLevel"
      ],
      "type": "object"
    },
    "SelfServiceTask": {
      "description": "One directory interface; software does not inherit script parameter semantics.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Resource-owned script execution interface.",
          "properties": {
            "kind": {
              "const": "script",
              "type": "string"
            },
            "parameterSchema": {
              "description": "Full resolved parameter constraints owned by Resource."
            },
            "parameterSources": {
              "additionalProperties": {
                "$ref": "#/$defs/ScriptParameterSource"
              },
              "description": "Complete sources for script parameters.",
              "type": "object"
            },
            "resource": {
              "$ref": "#/$defs/TaskResource",
              "description": "Exact Resource selection."
            },
            "runAs": {
              "$ref": "#/$defs/ExecutionIdentity",
              "description": "Required operating-system identity."
            }
          },
          "required": [
            "kind",
            "resource",
            "runAs",
            "parameterSources",
            "parameterSchema"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit request for approved AvailableInstall software.",
          "properties": {
            "kind": {
              "const": "software",
              "type": "string"
            },
            "resource": {
              "$ref": "#/$defs/TaskResource",
              "description": "Exact Resource selection."
            },
            "runAs": {
              "$ref": "#/$defs/ExecutionIdentity",
              "description": "Required operating-system identity of the root operation."
            },
            "target": {
              "$ref": "#/$defs/SoftwareExecutionTarget",
              "description": "Exact effect target, distinct from enterprise login."
            }
          },
          "required": [
            "kind",
            "resource",
            "runAs",
            "target"
          ],
          "type": "object"
        }
      ]
    },
    "SoftwareExecutionTarget": {
      "description": "Concrete effect target bound before an Offer is signed.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Device installation or provisioning; user registration is a different target.",
          "properties": {
            "kind": {
              "const": "device",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One exact live interactive OS account and login generation.",
          "properties": {
            "identity": {
              "description": "Exact SID/UID.",
              "maxLength": 184,
              "minLength": 1,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            "kind": {
              "const": "user",
              "type": "string"
            },
            "sessionId": {
              "description": "Exact login generation.",
              "format": "uuid",
              "not": {
                "const": "00000000-0000-0000-0000-000000000000"
              },
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "identity",
            "sessionId"
          ],
          "type": "object"
        }
      ]
    },
    "TaskResource": {
      "additionalProperties": false,
      "description": "Exact Resource identity accompanying its signed digest.",
      "properties": {
        "id": {
          "description": "Logical Resource identity.",
          "type": "string"
        },
        "variant": {
          "description": "Exact selected variant.",
          "type": "string"
        },
        "version": {
          "description": "Immutable Resource version.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "variant"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Directory response consumed by the Agent service and employee UI.",
  "properties": {
    "asOf": {
      "description": "Server observation time in Unix seconds.",
      "format": "int64",
      "type": "integer"
    },
    "items": {
      "description": "Authorized directory entries.",
      "items": {
        "$ref": "#/$defs/SelfServiceDirectoryItem"
      },
      "type": "array"
    },
    "nextCursor": {
      "description": "Last examined Policy when another page may exist.",
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "items",
    "asOf"
  ],
  "title": "SelfServiceDirectoryResponse",
  "type": "object",
  "$id": "https://rss.example/mdm/agent/runtime/v1/payload/v1/self-service-directory-response.schema.json"
}
