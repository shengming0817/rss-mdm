{
  "$defs": {
    "OutputQuality": {
      "description": "Output completeness controls whether collection facts may be accepted.",
      "oneOf": [
        {
          "const": "complete",
          "description": "Complete successful capture within all budgets.",
          "type": "string"
        },
        {
          "const": "partial",
          "description": "Only a subset was collected.",
          "type": "string"
        },
        {
          "const": "truncated",
          "description": "A configured output or row limit was reached.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Execution or capture failed.",
          "type": "string"
        }
      ]
    },
    "ScriptCancellation": {
      "description": "Public cancellation observation.",
      "oneOf": [
        {
          "const": "none",
          "description": "No cancellation requested.",
          "type": "string"
        },
        {
          "const": "requested",
          "description": "Cancellation requested but not acknowledged.",
          "type": "string"
        },
        {
          "const": "confirmed",
          "description": "Cancellation acknowledged or stopped before execution.",
          "type": "string"
        }
      ]
    },
    "ScriptDelivery": {
      "description": "Public delivery observation, independent of the server reducer implementation.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Awaiting a device claim.",
          "properties": {
            "kind": {
              "const": "queued",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Claimed by one leased attempt.",
          "properties": {
            "attempt": {
              "description": "Attempt identity.",
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "claimed",
              "type": "string"
            },
            "leaseUntil": {
              "description": "Lease expiry in Unix seconds.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "attempt",
            "leaseUntil"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Receipt acknowledged by one leased attempt.",
          "properties": {
            "attempt": {
              "description": "Attempt identity.",
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "received",
              "type": "string"
            },
            "leaseUntil": {
              "description": "Lease expiry in Unix seconds.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "attempt",
            "leaseUntil"
          ],
          "type": "object"
        }
      ]
    },
    "ScriptExecution": {
      "description": "Public execution observation. Unknown never authorizes a blind retry.",
      "oneOf": [
        {
          "const": "not_started",
          "description": "No Start has been admitted.",
          "type": "string"
        },
        {
          "const": "running",
          "description": "Execution was admitted and is running.",
          "type": "string"
        },
        {
          "const": "succeeded",
          "description": "A successful result was recorded.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "A failed result was recorded.",
          "type": "string"
        },
        {
          "const": "waiting_reboot",
          "description": "Execution awaits a reboot observation.",
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "The effect is uncertain.",
          "type": "string"
        }
      ]
    },
    "ScriptOutputReference": {
      "additionalProperties": false,
      "description": "Reference for output too large or outside its declared Resource budget.",
      "properties": {
        "bytes": {
          "description": "Exact encoded JSON byte count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "description": "SHA-256 of those exact bytes.",
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "ScriptRunResult": {
      "additionalProperties": false,
      "description": "Server-persisted script evidence; only Resource output has a dynamic shape.",
      "properties": {
        "budgetValid": {
          "description": "Whether the output satisfies Resource budgets.",
          "type": "boolean"
        },
        "collectedAt": {
          "description": "Agent's original collection timestamp in Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "diagnostics": {
          "$ref": "#/$defs/TaskDiagnostics",
          "description": "Original bounded process diagnostics."
        },
        "exitCode": {
          "description": "Original process exit code, absent when unavailable.",
          "format": "int32",
          "type": [
            "integer",
            "null"
          ]
        },
        "output": {
          "description": "Resource-defined output, or null when retained only by reference."
        },
        "outputReference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptOutputReference"
            },
            {
              "type": "null"
            }
          ],
          "description": "Digest and size when output is retained by reference."
        },
        "quality": {
          "$ref": "#/$defs/OutputQuality",
          "description": "Original completeness classification."
        },
        "receivedAt": {
          "description": "Server receipt timestamp in Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "schemaValid": {
          "description": "Whether the output matches the Resource schema.",
          "type": "boolean"
        },
        "trusted": {
          "description": "Whether this evidence may contribute current inventory facts.",
          "type": "boolean"
        }
      },
      "required": [
        "collectedAt",
        "receivedAt",
        "exitCode",
        "quality",
        "schemaValid",
        "budgetValid",
        "output",
        "outputReference",
        "diagnostics",
        "trusted"
      ],
      "type": "object"
    },
    "ScriptRunState": {
      "additionalProperties": false,
      "description": "Current durable Run observation, without server-side reducer methods.",
      "properties": {
        "cancellation": {
          "$ref": "#/$defs/ScriptCancellation",
          "description": "Current cancellation observation."
        },
        "deadline": {
          "description": "Final Run deadline in Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "delivery": {
          "$ref": "#/$defs/ScriptDelivery",
          "description": "Current delivery observation."
        },
        "execution": {
          "$ref": "#/$defs/ScriptExecution",
          "description": "Current execution observation."
        },
        "startedAt": {
          "description": "Server time at which execution was admitted.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "delivery",
        "execution",
        "cancellation",
        "deadline"
      ],
      "type": "object"
    },
    "TaskDiagnostics": {
      "additionalProperties": false,
      "description": "Private bounded process diagnostics.",
      "properties": {
        "durationMs": {
          "format": "uint64",
          "maximum": 604800000,
          "minimum": 0,
          "type": "integer"
        },
        "executedAt": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "stderr": {
          "maxLength": 16384,
          "pattern": "^[^\\u0000]*$",
          "type": "string"
        },
        "stdout": {
          "maxLength": 16384,
          "pattern": "^[^\\u0000]*$",
          "type": "string"
        }
      },
      "required": [
        "stdout",
        "stderr",
        "durationMs",
        "executedAt",
        "failure"
      ],
      "type": "object"
    },
    "TaskFailure": {
      "description": "Closed executor failure classification.",
      "oneOf": [
        {
          "const": "launch_failed",
          "description": "The executor process could not be launched.",
          "type": "string"
        },
        {
          "const": "timed_out",
          "description": "The configured execution deadline elapsed.",
          "type": "string"
        },
        {
          "const": "cancelled",
          "description": "Execution was cancelled before a complete result was produced.",
          "type": "string"
        },
        {
          "const": "non_zero_exit",
          "description": "The process exited with a non-zero status.",
          "type": "string"
        },
        {
          "const": "output_limit",
          "description": "A configured output or row limit was reached.",
          "type": "string"
        },
        {
          "const": "capture_failed",
          "description": "The executor could not capture a complete result.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Status of an invocation by this device and authenticated employee.",
  "properties": {
    "attemptId": {
      "description": "Current attempt identity, if claimed.",
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "availableAt": {
      "description": "Earliest server admission time in Unix seconds.",
      "format": "int64",
      "type": "integer"
    },
    "deadline": {
      "description": "Final Run deadline in Unix seconds.",
      "format": "int64",
      "type": "integer"
    },
    "requestId": {
      "description": "Durable idempotency identity of the invocation.",
      "format": "uuid",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScriptRunResult"
        },
        {
          "type": "null"
        }
      ],
      "description": "Authorized result with native collection time and server receipt time."
    },
    "runId": {
      "description": "Durable Run identity.",
      "format": "uuid",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/ScriptRunState",
      "description": "Current durable Run observation."
    }
  },
  "required": [
    "requestId",
    "runId",
    "state",
    "availableAt",
    "deadline",
    "result"
  ],
  "title": "SelfServiceStatus",
  "type": "object",
  "$id": "https://rss.example/mdm/agent/runtime/v1/payload/v1/self-service-status.schema.json"
}
