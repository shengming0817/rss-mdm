{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Presented over real candidate mTLS to activate that exact certificate.",
  "properties": {
    "issuanceId": {
      "description": "Persisted candidate identity.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "operationId": {
      "description": "Stable activation retry identity.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "wireVersion": {
      "const": 1,
      "description": "Enrollment API version."
    }
  },
  "required": [
    "wireVersion",
    "issuanceId",
    "operationId"
  ],
  "title": "ActivationRequest",
  "type": "object",
  "$id": "https://rss.example/agent/enroll/v1/ActivationRequest"
}
