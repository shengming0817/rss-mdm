{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/agent/enroll/v1/ActivationRequest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "wireVersion": {
      "const": 1
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "issuanceId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    }
  },
  "required": [
    "wireVersion",
    "operationId",
    "issuanceId"
  ],
  "$defs": {}
}
