{
  "$defs": {
    "Secret": {
      "description": "Canonical 256-bit base64url secret. Debug output is always redacted.",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Poll only the request identified by the secret and original operation.",
  "properties": {
    "grantId": {
      "description": "Grant identity.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "operationId": {
      "description": "Original creation operation identity.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "secret": {
      "$ref": "#/$defs/Secret",
      "description": "Polling/bootstrap secret.",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "wireVersion": {
      "const": 1,
      "description": "Enrollment API version."
    }
  },
  "required": [
    "wireVersion",
    "grantId",
    "operationId",
    "secret"
  ],
  "title": "StatusRequest",
  "type": "object",
  "$id": "https://rss.example/agent/enroll/v1/StatusRequest"
}
