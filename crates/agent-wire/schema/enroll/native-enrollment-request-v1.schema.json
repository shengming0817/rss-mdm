{
  "$defs": {
    "Secret": {
      "description": "Canonical 256-bit base64url secret. Debug output is always redacted.",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exchange a started signed enrollment task for one short-lived OS handoff.",
  "properties": {
    "attemptId": {
      "description": "Exact started task attempt.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "operationId": {
      "description": "Stable exchange operation retained across unknown results.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "password": {
      "$ref": "#/$defs/Secret",
      "description": "Locally generated handoff secret; preserved for exact retry, never in a URL."
    }
  },
  "required": [
    "operationId",
    "attemptId",
    "password"
  ],
  "title": "NativeEnrollmentRequest",
  "type": "object",
  "$id": "https://rss.example/agent/enroll/v1/NativeEnrollmentRequest"
}
