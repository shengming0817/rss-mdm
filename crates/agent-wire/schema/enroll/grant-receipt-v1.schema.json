{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/agent/enroll/v1/GrantReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wireVersion",
    "grantId",
    "state",
    "expiresAt",
    "platform"
  ],
  "properties": {
    "wireVersion": {
      "const": 1
    },
    "grantId": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "state": {
      "enum": [
        "pending",
        "available",
        "consumed",
        "revoked",
        "expired"
      ]
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1
    },
    "platform": {
      "enum": [
        "windows",
        "macos"
      ]
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
