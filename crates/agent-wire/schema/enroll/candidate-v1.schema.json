{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A durable certificate candidate; not an active device identity.",
  "properties": {
    "activateBefore": {
      "description": "The original grant deadline; a long certificate does not extend it.",
      "format": "int64",
      "minimum": 1,
      "type": "integer"
    },
    "certificateChain": {
      "description": "Leaf-first base64 DER chain, already validated by the server.",
      "items": {
        "maxLength": 43692,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
    },
    "issuanceId": {
      "description": "Fixed server signing attempt identity.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "operationId": {
      "description": "Original client signing operation.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "wireVersion": {
      "const": 1,
      "description": "Enrollment API version."
    }
  },
  "required": [
    "wireVersion",
    "issuanceId",
    "operationId",
    "certificateChain",
    "activateBefore"
  ],
  "title": "Candidate",
  "type": "object",
  "$id": "https://rss.example/agent/enroll/v1/Candidate"
}
