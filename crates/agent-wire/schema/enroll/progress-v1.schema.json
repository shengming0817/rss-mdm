{
  "$defs": {
    "ActivationReceipt": {
      "additionalProperties": false,
      "description": "Durable activation result, including an independently versioned runtime binding.",
      "properties": {
        "issuanceId": {
          "description": "Exact activated issuance.",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "operationId": {
          "description": "Activation operation identity.",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/BindingProfile",
          "description": "Runtime binding and collection definitions selected by the server."
        },
        "wireVersion": {
          "const": 1,
          "description": "Enrollment API version."
        }
      },
      "required": [
        "wireVersion",
        "issuanceId",
        "operationId",
        "runtime"
      ],
      "type": "object"
    },
    "BindingProfile": {
      "additionalProperties": false,
      "description": "Durable registration result. It never contains the submitted credential.",
      "properties": {
        "capabilities": {
          "description": "Exact accepted capability set.",
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "maxItems": 22,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "collections": {
          "description": "Server-selected built-in collector versions for this registration.",
          "items": {
            "$ref": "#/$defs/CollectionDefinition"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        },
        "deviceId": {
          "description": "Server-owned product device identity.",
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]*$",
          "type": "string"
        },
        "epoch": {
          "description": "Observation epoch for this registration.",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "generation": {
          "description": "Channel-local registration generation.",
          "format": "uint64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        },
        "operationId": {
          "description": "Registration operation replay identity.",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "registrationId": {
          "description": "Immutable registration identity.",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ReportSource",
          "const": "agent.builtin",
          "description": "Authorized report source."
        },
        "wireVersion": {
          "const": 1,
          "description": "Exact wire major."
        }
      },
      "required": [
        "wireVersion",
        "operationId",
        "deviceId",
        "registrationId",
        "generation",
        "source",
        "epoch",
        "capabilities",
        "collections"
      ],
      "type": "object"
    },
    "Capability": {
      "description": "Closed V1 capability set.",
      "oneOf": [
        {
          "const": "inventory.collect.v1",
          "description": "Full/partial/failed reports for the two basic inventory fields.",
          "type": "string"
        },
        {
          "const": "task.execute.v1",
          "description": "Receive and execute signed task offers.",
          "type": "string"
        },
        {
          "const": "software.msi.system.v1",
          "description": "Execute the exact software.msi.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.msi.user.v1",
          "description": "Execute the exact software.msi.user.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.pkg.system.v1",
          "description": "Execute the exact software.pkg.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.bundle.windows.system.v1",
          "description": "Execute the exact software.bundle.windows.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.bundle.windows.user.v1",
          "description": "Execute the exact software.bundle.windows.user.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.bundle.macos.system.v1",
          "description": "Execute the exact software.bundle.macos.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.bundle.macos.user.v1",
          "description": "Execute the exact software.bundle.macos.user.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.winget.system.v1",
          "description": "Execute the exact software.winget.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.winget.user.v1",
          "description": "Execute the exact software.winget.user.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.brew.bottle.user.v1",
          "description": "Execute the exact software.brew.bottle.user.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.exe.system.v1",
          "description": "Execute the exact software.exe.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.exe.user.v1",
          "description": "Execute the exact software.exe.user.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.dmg.app.system.v1",
          "description": "Execute the exact software.dmg.app.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.dmg.app.user.v1",
          "description": "Execute the exact software.dmg.app.user.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.dmg.pkg.system.v1",
          "description": "Execute the exact software.dmg.pkg.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.msix.registration.user.v1",
          "description": "Execute the exact software.msix.registration.user.v1 profile.",
          "type": "string"
        },
        {
          "const": "software.msix.provisioning.system.v1",
          "description": "Execute the exact software.msix.provisioning.system.v1 profile.",
          "type": "string"
        },
        {
          "const": "mdm.enrollment.v1",
          "description": "Open the standard MDM enrollment entry with OS/user approval.",
          "type": "string"
        },
        {
          "const": "device.unmanage.v1",
          "description": "Administrator-authorized Agent retirement.",
          "type": "string"
        },
        {
          "const": "inventory.native.v1",
          "description": "Execute signed declarative native inventory tasks.",
          "type": "string"
        },
        {
          "const": "credentials.windows.v1",
          "description": "Native Windows recovery material execution and encrypted escrow.",
          "type": "string"
        },
        {
          "const": "telemetry.collect.v1",
          "description": "Periodic typed observations using published telemetry profiles.",
          "type": "string"
        },
        {
          "const": "telemetry.counter.local.v1",
          "description": "Durable local baselines for explicitly signed native cumulative counters.",
          "type": "string"
        },
        {
          "const": "device_access.v1",
          "description": "Typed local-account Device Access operations.",
          "type": "string"
        },
        {
          "const": "device_access.whfb.v1",
          "description": "Native Windows Hello management, independent of RSS credential-provider availability.",
          "type": "string"
        }
      ]
    },
    "CollectionDefinition": {
      "additionalProperties": false,
      "description": "Frozen source and field definitions for one published collector version.\nConstructing this value validates structure; the caller still owns tenant/device authorization.",
      "properties": {
        "dataset": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDefinition"
          },
          "maxItems": 128,
          "minItems": 1,
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/CollectionScope",
          "const": {
            "kind": "device"
          }
        },
        "source": {
          "$ref": "#/$defs/Source",
          "not": {
            "const": "manual"
          }
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "version",
        "source",
        "scope",
        "fields"
      ],
      "type": "object"
    },
    "CollectionScope": {
      "description": "Exact namespace of collected values. Only device-wide projection is currently executable.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Complete device-wide namespace.",
          "properties": {
            "kind": {
              "const": "device",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One explicitly identified user; never merged into device-wide facts.",
          "properties": {
            "identity": {
              "description": "Stable account identity.",
              "type": "string"
            },
            "kind": {
              "const": "user",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "identity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One provider-specific namespace.",
          "properties": {
            "identity": {
              "description": "Stable provider identity.",
              "type": "string"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "identity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One stable volume identity, independent of drive letter.",
          "properties": {
            "identity": {
              "description": "Stable volume identity.",
              "type": "string"
            },
            "kind": {
              "const": "volume",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "identity"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One explicit path prefix.",
          "properties": {
            "kind": {
              "const": "prefix",
              "type": "string"
            },
            "path": {
              "description": "Exact path prefix.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "FieldDefinition": {
      "additionalProperties": false,
      "description": "A published field version. No time-based expiry and no execution permission.",
      "properties": {
        "itemKey": {
          "description": "Optional stable item-key property for a structured inventory list.",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "$ref": "#/$defs/FieldKey",
          "description": "Stable field identity.",
          "maxLength": 128,
          "pattern": "^(device|custom|channel)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "manual": {
          "description": "Whether management assignment is permitted.",
          "type": "boolean"
        },
        "nullable": {
          "description": "Accept explicit null as distinct from deletion.",
          "type": "boolean"
        },
        "platforms": {
          "description": "Supported platforms.",
          "items": {
            "$ref": "#/$defs/Platform"
          },
          "maxItems": 2,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "searchable": {
          "description": "Whether this field participates in conditions/search.",
          "type": "boolean"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity",
          "description": "Read/filter visibility classification."
        },
        "sources": {
          "additionalProperties": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "description": "Allowed sources with priority; lower numbers win, equal numbers require consensus.",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/Source"
          },
          "type": "object"
        },
        "timeSeries": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeSeriesBinding"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional history binding; absence means this field has no time-series capability."
        },
        "unit": {
          "description": "Exact optional unit; no implicit conversion.",
          "maxLength": 64,
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "valueType": {
          "$ref": "#/$defs/ValueType",
          "description": "Exact bounded type."
        },
        "version": {
          "description": "Monotonic published version.",
          "format": "uint64",
          "maximum": 9223372036854775807,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "version",
        "valueType",
        "nullable",
        "manual",
        "sources",
        "platforms",
        "sensitivity",
        "unit",
        "searchable",
        "itemKey"
      ],
      "type": "object"
    },
    "FieldKey": {
      "description": "Bounded protocol field identity; parsing grants no catalog or source authority.",
      "maxLength": 128,
      "pattern": "^(device|custom|channel)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
      "type": "string"
    },
    "GrantReceipt": {
      "additionalProperties": false,
      "description": "Public progress; never includes the bootstrap secret.",
      "properties": {
        "expiresAt": {
          "description": "Original authorization deadline, Unix seconds.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "grantId": {
          "description": "Server-held request/grant identity.",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/TaskPlatform",
          "description": "Authorized platform."
        },
        "state": {
          "$ref": "#/$defs/GrantState",
          "description": "Current authorization state."
        },
        "wireVersion": {
          "const": 1,
          "description": "Enrollment API version."
        }
      },
      "required": [
        "wireVersion",
        "grantId",
        "state",
        "expiresAt",
        "platform"
      ],
      "type": "object"
    },
    "GrantState": {
      "description": "Persisted authorization lifecycle.",
      "oneOf": [
        {
          "const": "pending",
          "description": "Waiting for an authenticated user to approve the exact client request.",
          "type": "string"
        },
        {
          "const": "available",
          "description": "Authorized and not yet consumed.",
          "type": "string"
        },
        {
          "const": "consumed",
          "description": "Bound to one certificate operation and public key.",
          "type": "string"
        },
        {
          "const": "revoked",
          "description": "Explicitly cancelled or revoked.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "Original authorization deadline has elapsed.",
          "type": "string"
        }
      ]
    },
    "Platform": {
      "description": "Platform applicable to a field or collector.",
      "oneOf": [
        {
          "const": "windows",
          "description": "Windows.",
          "type": "string"
        },
        {
          "const": "macos",
          "description": "macOS.",
          "type": "string"
        }
      ]
    },
    "Property": {
      "additionalProperties": false,
      "description": "One explicitly declared record member.",
      "properties": {
        "required": {
          "description": "Whether the producer must include this member.",
          "type": "boolean"
        },
        "valueType": {
          "$ref": "#/$defs/ValueType",
          "description": "Exact type when present."
        }
      },
      "required": [
        "valueType",
        "required"
      ],
      "type": "object"
    },
    "ReportSource": {
      "description": "Server-owned report source returned after registration.",
      "oneOf": [
        {
          "const": "agent.builtin",
          "description": "Built-in RSS Agent inventory collector.",
          "type": "string"
        }
      ]
    },
    "RetentionReference": {
      "additionalProperties": false,
      "description": "Product retention policy identity; duration is owned by its immutable policy version.",
      "properties": {
        "key": {
          "description": "Tenant-local policy key.",
          "type": "string"
        },
        "revision": {
          "description": "Exact policy revision.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "revision"
      ],
      "type": "object"
    },
    "Sensitivity": {
      "description": "Field visibility class, enforced by the product authorization boundary.",
      "oneOf": [
        {
          "const": "standard",
          "description": "Ordinary inventory.",
          "type": "string"
        },
        {
          "const": "sensitive",
          "description": "Requires the sensitive inventory permission.",
          "type": "string"
        }
      ]
    },
    "Source": {
      "description": "All allowed asset sources. Serialized as their canonical stable identifier.",
      "oneOf": [
        {
          "const": "agent.script",
          "description": "Controlled collection script evidence.",
          "type": "string"
        },
        {
          "const": "agent.native",
          "description": "Signed declarative native task evidence.",
          "type": "string"
        },
        {
          "const": "agent.osquery",
          "description": "Published SQL template evidence.",
          "type": "string"
        },
        {
          "const": "mdm.apple",
          "description": "Apple MDM evidence.",
          "type": "string"
        },
        {
          "const": "agent.builtin",
          "description": "Built-in agent evidence.",
          "type": "string"
        },
        {
          "const": "manual",
          "description": "Administrator assignment.",
          "type": "string"
        },
        {
          "const": "mdm.windows",
          "description": "Windows MDM evidence.",
          "type": "string"
        }
      ]
    },
    "TaskPlatform": {
      "description": "Exact operating system of the selected immutable artifact.",
      "oneOf": [
        {
          "const": "windows",
          "description": "Windows.",
          "type": "string"
        },
        {
          "const": "macos",
          "description": "macOS.",
          "type": "string"
        }
      ]
    },
    "TelemetryAggregation": {
      "description": "Operations are selected explicitly; missing data is never filled implicitly.",
      "oneOf": [
        {
          "const": "min",
          "description": "Minimum numeric reading.",
          "type": "string"
        },
        {
          "const": "max",
          "description": "Maximum numeric reading.",
          "type": "string"
        },
        {
          "const": "sum",
          "description": "Sum of Gauge readings or Delta contributions.",
          "type": "string"
        },
        {
          "const": "count",
          "description": "Number of known readings.",
          "type": "string"
        },
        {
          "const": "mean",
          "description": "Numeric arithmetic mean.",
          "type": "string"
        },
        {
          "const": "increase",
          "description": "Cumulative increase between compatible boundaries.",
          "type": "string"
        },
        {
          "const": "rate",
          "description": "Contribution divided by its actual duration.",
          "type": "string"
        },
        {
          "const": "timeline",
          "description": "Finite state intervals.",
          "type": "string"
        },
        {
          "const": "transitions",
          "description": "State changes.",
          "type": "string"
        },
        {
          "const": "coverage",
          "description": "Explicitly covered duration.",
          "type": "string"
        }
      ]
    },
    "TelemetryDimension": {
      "additionalProperties": false,
      "description": "One bounded dimension extracted from a declared object property path.",
      "properties": {
        "path": {
          "description": "Literal property names relative to each selected item, not executable expressions.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "values": {
          "description": "Closed admitted vocabulary, including numeric dimensions rendered canonically.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "path",
        "values"
      ],
      "type": "object"
    },
    "TelemetryKind": {
      "description": "Numeric interpretation is immutable for a field identity.",
      "oneOf": [
        {
          "const": "gauge",
          "description": "Instantaneous numeric observation.",
          "type": "string"
        },
        {
          "const": "cumulative_counter",
          "description": "Nonnegative value since an explicit reset boundary.",
          "type": "string"
        },
        {
          "const": "delta_counter",
          "description": "Nonnegative contribution over an explicit interval.",
          "type": "string"
        },
        {
          "const": "state",
          "description": "Boolean or declared finite string vocabulary.",
          "type": "string"
        }
      ]
    },
    "TimeSeriesBinding": {
      "additionalProperties": false,
      "description": "A field's optional history capability, validated against the Inventory catalog.",
      "properties": {
        "aggregations": {
          "description": "Explicit operations permitted for this field.",
          "items": {
            "$ref": "#/$defs/TelemetryAggregation"
          },
          "type": "array",
          "uniqueItems": true
        },
        "dimensions": {
          "additionalProperties": {
            "$ref": "#/$defs/TelemetryDimension"
          },
          "description": "Closed dimensions. Device/resource/source identities are not arbitrary dimensions.",
          "type": "object"
        },
        "intervalStartPath": {
          "description": "Counter start in UTC microseconds, extracted per item for structured counters.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/TelemetryKind",
          "description": "Numeric or finite-state interpretation."
        },
        "maxResources": {
          "description": "Maximum expanded resources per device and field.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retention": {
          "$ref": "#/$defs/RetentionReference",
          "description": "Versioned product policy, never an asset TTL."
        },
        "valuePath": {
          "description": "Scalar property path; an array root is expanded using the field's stable item key.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "valuePath",
        "dimensions",
        "aggregations",
        "retention",
        "maxResources"
      ],
      "type": "object"
    },
    "ValueType": {
      "description": "Closed structural schema for one field; every property is explicit and required.",
      "oneOf": [
        {
          "additionalProperties": false,
