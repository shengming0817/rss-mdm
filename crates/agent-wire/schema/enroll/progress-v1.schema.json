          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Persisted signing attempt, when consumed."
    },
    "issuanceUnknown": {
      "description": "Signing is unknown; retry/status never causes another CA request.",
      "type": "boolean"
    }
  },
  "required": [
    "grant",
    "issuanceId",
    "issuanceUnknown",
    "activation"
  ],
  "title": "Progress",
