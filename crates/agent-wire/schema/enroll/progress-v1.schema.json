{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/agent/enroll/v1/Progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "grant",
    "issuanceId",
    "issuanceUnknown",
    "activation"
  ],
  "properties": {
    "grant": {
      "$ref": "#/$defs/grantReceipt"
    },
    "issuanceId": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonNilUuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "issuanceUnknown": {
      "type": "boolean"
    },
    "activation": {
      "anyOf": [
        {
          "$ref": "#/$defs/activationReceipt"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "fieldType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "maxLength",
            "allowEmpty"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "allowEmpty": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items",
            "maxItems"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/fieldType"
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "properties"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 64,
              "propertyNames": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/fieldType"
              }
            }
          }
        }
      ]
    },
    "fieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "valueType",
        "nullable",
        "manual",
        "sources",
        "platforms",
        "sensitivity",
        "unit",
        "searchable",
        "itemKey"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(device|custom|channel)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "valueType": {
          "$ref": "#/$defs/fieldType"
        },
        "nullable": {
          "type": "boolean"
        },
        "manual": {
          "type": "boolean"
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "mdm.windows",
              "mdm.apple",
              "agent.builtin",
              "agent.script",
              "agent.osquery",
              "manual"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "macos"
            ]
          }
        },
        "sensitivity": {
          "enum": [
            "standard",
            "sensitive"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "searchable": {
          "type": "boolean"
        },
        "itemKey": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "version",
        "source",
        "fields"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "source": {
          "enum": [
            "mdm.windows",
            "mdm.apple",
            "agent.builtin",
            "agent.script",
            "agent.osquery"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/fieldDefinition"
          }
        }
      }
    },
    "bindingProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wireVersion",
        "operationId",
        "deviceId",
        "registrationId",
        "generation",
        "source",
        "epoch",
        "capabilities",
        "collections"
      ],
      "properties": {
        "wireVersion": {
          "const": 1
        },
        "operationId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]*$"
        },
        "registrationId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "source": {
          "const": "agent.builtin"
        },
        "epoch": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "prefixItems": [
            {
              "const": "inventory.collect.v1"
            }
          ],
          "items": {
            "enum": [
              "inventory.collect.v1",
              "task.execute.v1",
              "software.msi.system.v1",
              "software.msi.user.v1",
              "software.pkg.system.v1",
              "software.bundle.windows.system.v1",
              "software.bundle.windows.user.v1",
              "software.bundle.macos.system.v1",
              "software.bundle.macos.user.v1",
              "software.winget.system.v1",
              "software.winget.user.v1",
              "software.brew.bottle.user.v1",
              "software.exe.system.v1",
              "software.exe.user.v1",
              "software.dmg.app.system.v1",
              "software.dmg.app.user.v1",
              "software.dmg.pkg.system.v1",
              "software.msix.registration.user.v1",
              "software.msix.provisioning.system.v1",
              "mdm.enrollment.v1"
            ]
          }
        },
        "collections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/collection"
          }
        }
      }
    },
    "grantReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wireVersion",
        "grantId",
        "state",
        "expiresAt",
        "platform"
      ],
      "properties": {
        "wireVersion": {
          "const": 1
        },
        "grantId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "state": {
          "enum": [
            "pending",
            "available",
            "consumed",
            "revoked",
            "expired"
          ]
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "enum": [
            "windows",
            "macos"
          ]
        }
      }
    },
    "activationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wireVersion",
        "issuanceId",
        "operationId",
        "runtime"
      ],
      "properties": {
        "wireVersion": {
          "const": 1
        },
        "issuanceId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "operationId": {
          "$ref": "#/$defs/nonNilUuid"
        },
        "runtime": {
          "$ref": "#/$defs/bindingProfile"
        }
      }
    }
  }
}
