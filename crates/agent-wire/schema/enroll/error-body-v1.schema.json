{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/agent/enroll/v1/ErrorBody",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "issuanceId"
  ],
  "properties": {
    "code": {
      "enum": [
        "malformed_request",
        "invalid_identity",
        "permission_denied",
        "grant_revoked",
        "grant_expired",
        "registration_limit",
        "operation_conflict",
        "issuance_unknown",
        "activation_unknown",
        "credential_revoked",
        "certificate_expired",
        "credential_retired",
        "service_unavailable"
      ]
    },
    "issuanceId": {
      "anyOf": [
        {
          "$ref": "#/$defs/nonNilUuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
