{
  "$defs": {
    "Secret": {
      "description": "Canonical 256-bit base64url secret. Debug output is always redacted.",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "TaskPlatform": {
      "description": "Exact operating system of the selected immutable artifact.",
      "oneOf": [
        {
          "const": "windows",
          "description": "Windows.",
          "type": "string"
        },
        {
          "const": "macos",
          "description": "macOS.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A user download grant or an unauthenticated client authorization request.",
  "properties": {
    "csr": {
      "description": "Base64 DER CSR; required for a client browser-authorization request.",
      "type": [
        "string",
        "null"
      ]
    },
    "lifetimeSeconds": {
      "description": "Optional shorter lifetime; tenant policy remains the upper bound.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "operationId": {
      "description": "Caller-selected stable request and retry identity.",
      "format": "uuid",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "platform": {
      "$ref": "#/$defs/TaskPlatform",
      "description": "Requested platform, fixed by authorization."
    },
    "secret": {
      "$ref": "#/$defs/Secret",
      "description": "Caller-generated secret, delivered in protected bootstrap material.",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "wireVersion": {
      "const": 1,
      "description": "Enrollment API version."
    }
  },
  "required": [
    "wireVersion",
    "operationId",
    "secret",
    "platform"
  ],
  "title": "GrantRequest",
  "type": "object",
  "$id": "https://rss.example/agent/enroll/v1/GrantRequest"
}
