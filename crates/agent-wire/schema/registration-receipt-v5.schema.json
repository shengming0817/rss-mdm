{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v5/registration-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wireVersion",
    "operationId",
    "deviceId",
    "registrationId",
    "generation",
    "source",
    "epoch",
    "capabilities",
    "collections"
  ],
  "properties": {
    "wireVersion": {
      "const": 5
    },
    "operationId": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]*$"
    },
    "registrationId": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "source": {
      "const": "agent.builtin"
    },
    "epoch": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "capabilities": {
      "enum": [
        [
          "inventory.collect.v5"
        ],
        [
          "inventory.collect.v5",
          "task.execute.v5"
        ],
        [
          "inventory.collect.v5",
          "software.execute.v5"
        ],
        [
          "inventory.collect.v5",
          "task.execute.v5",
          "software.execute.v5"
        ],
        [
          "inventory.collect.v5",
          "mdm.enrollment.v5"
        ],
        [
          "inventory.collect.v5",
          "task.execute.v5",
          "mdm.enrollment.v5"
        ],
        [
          "inventory.collect.v5",
          "software.execute.v5",
          "mdm.enrollment.v5"
        ],
        [
          "inventory.collect.v5",
          "task.execute.v5",
          "software.execute.v5",
          "mdm.enrollment.v5"
        ]
      ]
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/collection"
      }
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "fieldType": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "time"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "maxLength",
            "allowEmpty"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "allowEmpty": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "items",
            "maxItems"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "items": {
              "$ref": "#/$defs/fieldType"
            },
            "maxItems": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "properties"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "properties": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 64,
              "propertyNames": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/fieldType"
              }
            }
          }
        }
      ]
    },
    "fieldDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "version",
        "valueType",
        "nullable",
        "manual",
        "sources",
        "platforms",
        "sensitivity",
        "unit",
        "searchable",
        "itemKey"
      ],
      "properties": {
        "key": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(device|custom|channel)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "valueType": {
          "$ref": "#/$defs/fieldType"
        },
        "nullable": {
          "type": "boolean"
        },
        "manual": {
          "type": "boolean"
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "mdm.windows",
              "mdm.apple",
              "agent.builtin",
              "agent.script",
              "agent.osquery",
              "manual"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows",
              "macos"
            ]
          }
        },
        "sensitivity": {
          "enum": [
            "standard",
            "sensitive"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 64
        },
        "searchable": {
          "type": "boolean"
        },
        "itemKey": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scalar": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string",
              "maxLength": 65536
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "integer"
            },
            "value": {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "number"
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "time"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "array"
            },
            "value": {
              "type": "array",
              "maxItems": 100000,
              "items": {
                "$ref": "#/$defs/scalar"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "object"
            },
            "value": {
              "type": "object",
              "maxProperties": 64,
              "propertyNames": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/scalar"
              }
            }
          }
        }
      ]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "version",
        "source",
        "fields"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
        },
        "source": {
          "enum": [
            "mdm.windows",
            "mdm.apple",
            "agent.builtin",
            "agent.script",
            "agent.osquery"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/fieldDefinition"
          }
        }
      }
    },
    "fieldValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(device|custom|channel)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "value": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "value"
              ],
              "properties": {
                "kind": {
                  "const": "value"
                },
                "value": {
                  "$ref": "#/$defs/scalar"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "deleted"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "unsupported"
                }
              }
            }
          ]
        }
      }
    }
  }
}
