{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v5/managed-registration-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wireVersion",
    "operationId",
    "installationOperation",
    "credential",
    "capabilities",
    "platform",
    "architecture",
    "executionContext"
  ],
  "properties": {
    "wireVersion": {
      "const": 5
    },
    "operationId": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "credential": {
      "$ref": "#/$defs/secret"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "inventory.collect.v5"
        }
      ],
      "items": {
        "enum": [
          "inventory.collect.v5",
          "task.execute.v5",
          "software.msi.system.v5",
          "software.msi.user.v5",
          "software.pkg.system.v5",
          "software.bundle.windows.system.v5",
          "software.bundle.windows.user.v5",
          "software.bundle.macos.system.v5",
          "software.bundle.macos.user.v5",
          "software.winget.system.v5",
          "software.winget.user.v5",
          "software.brew.bottle.user.v5",
          "software.exe.system.v5",
          "software.exe.user.v5",
          "software.dmg.app.system.v5",
          "software.dmg.app.user.v5",
          "software.dmg.pkg.system.v5",
          "software.msix.registration.user.v5",
          "software.msix.provisioning.system.v5",
          "mdm.enrollment.v5"
        ]
      }
    },
    "platform": {
      "enum": [
        "windows",
        "macos"
      ]
    },
    "architecture": {
      "enum": [
        "x86_64",
        "aarch64"
      ]
    },
    "installationOperation": {
      "$ref": "#/$defs/nonNilUuid"
    },
    "executionContext": {
      "$ref": "#/$defs/SoftwareExecutionContext"
    }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "SoftwareExecutionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "osVersion",
        "systemBroker",
        "interactiveUser",
        "sourceCredentials",
        "msixSideload",
        "msixUnsigned"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "osVersion": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "not": {
            "const": [
              0,
              0,
              0,
              0
            ]
          }
        },
        "systemBroker": {
          "type": "boolean"
        },
        "interactiveUser": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity",
                "sessionId",
                "administrator"
              ],
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 184,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "sessionId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "not": {
                    "const": "00000000-0000-0000-0000-000000000000"
                  }
                },
                "administrator": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "sourceCredentials": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "reference"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            }
          }
        },
        "msixSideload": {
          "type": "boolean"
        },
        "msixUnsigned": {
          "type": "boolean"
        }
      }
    }
  }
}
