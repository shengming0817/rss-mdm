{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v1/registration-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["wireVersion", "operationId", "enrollmentId", "password", "credential", "capabilities"],
  "properties": {
    "wireVersion": { "const": 1 },
    "operationId": { "$ref": "#/$defs/nonNilUuid" },
    "enrollmentId": { "$ref": "#/$defs/nonNilUuid" },
    "password": { "$ref": "#/$defs/secret" },
    "credential": { "$ref": "#/$defs/secret" },
    "capabilities": { "const": ["inventory.basic.v1"] }
  },
  "$defs": {
    "nonNilUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "secret": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    }
  }
}
