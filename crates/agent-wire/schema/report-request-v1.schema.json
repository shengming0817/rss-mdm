{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v1/report-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["wireVersion", "reportId", "sequence", "observedAt", "body"],
  "properties": {
    "wireVersion": { "const": 1 },
    "reportId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "not": { "const": "00000000-0000-0000-0000-000000000000" } },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "observedAt": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "body": {
      "oneOf": [
        { "$ref": "#/$defs/valuesBody", "properties": { "kind": { "const": "snapshot" } } },
        { "$ref": "#/$defs/valuesBody", "properties": { "kind": { "const": "partial" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "code"],
          "properties": {
            "kind": { "const": "failed" },
            "code": { "enum": ["permissionDenied", "temporarilyUnavailable", "collectionFailed"] }
          }
        }
      ]
    }
  },
  "$defs": {
    "valuesBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values"],
      "properties": {
        "kind": { "type": "string" },
        "values": {
          "type": "array",
          "maxItems": 2,
          "allOf": [
            { "contains": { "type": "object", "required": ["field"], "properties": { "field": { "const": "device.model" } } }, "minContains": 0, "maxContains": 1 },
            { "contains": { "type": "object", "required": ["field"], "properties": { "field": { "const": "device.os.version" } } }, "minContains": 0, "maxContains": 1 }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "value"],
            "properties": {
              "field": { "enum": ["device.model", "device.os.version"] },
              "value": {
                "oneOf": [
                  { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "const": "known" }, "value": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F]*$" } } },
                  { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unsupported" } } }
                ]
              }
            }
          }
        }
      }
    }
  }
}
