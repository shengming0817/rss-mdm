{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v6/task-claim-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wireVersion",
    "operationId",
    "profiles",
    "executionContext"
  ],
  "properties": {
    "wireVersion": {
      "const": 6
    },
    "operationId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "profiles": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "power_shell7",
          "posix_sh",
          "bash",
          "osquery"
        ]
      }
    },
    "executionContext": {
      "$ref": "#/$defs/SoftwareExecutionContext"
    }
  },
  "$defs": {
    "SoftwareExecutionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "osVersion",
        "systemBroker",
        "interactiveUser",
        "sourceCredentials",
        "msixSideload",
        "msixUnsigned"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "osVersion": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "not": {
            "const": [
              0,
              0,
              0,
              0
            ]
          }
        },
        "systemBroker": {
          "type": "boolean"
        },
        "interactiveUser": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "identity",
                "sessionId",
                "administrator"
              ],
              "properties": {
                "identity": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 184,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "sessionId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                  "not": {
                    "const": "00000000-0000-0000-0000-000000000000"
                  }
                },
                "administrator": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "sourceCredentials": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "reference"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              }
            }
          }
        },
        "msixSideload": {
          "type": "boolean"
        },
        "msixUnsigned": {
          "type": "boolean"
        }
      }
    }
  }
}
