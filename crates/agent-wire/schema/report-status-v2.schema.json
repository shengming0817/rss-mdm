{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rss.example/mdm/agent/v2/report-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ack",
    "observation",
    "projection"
  ],
  "properties": {
    "ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wireVersion",
        "reportId",
        "receivedAt",
        "intake"
      ],
      "properties": {
        "wireVersion": {
          "const": 2
        },
        "reportId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        },
        "receivedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "intake": {
          "const": "durable"
        }
      }
    },
    "observation": {
      "enum": [
        "pending",
        "snapshot",
        "needSnapshotPartial",
        "needSnapshotCollectionFailed",
        "stale"
      ]
    },
    "projection": {
      "enum": [
        "pending",
        "applied",
        "notApplicable"
      ]
    }
  }
}
