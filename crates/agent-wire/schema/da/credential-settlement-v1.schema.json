{
  "$defs": {
    "CredentialReceipt": {
      "additionalProperties": false,
      "description": "Durable escrow coordinates returned only for the exact accepted task event.",
      "properties": {
        "material": {
          "description": "Server-assigned entry identity.",
          "format": "uuid",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/CredentialSubject",
          "description": "Exact material subject."
        },
        "version": {
          "description": "Immutable material version.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "subject",
        "material",
        "version"
      ],
      "type": "object"
    },
    "CredentialState": {
      "description": "Persistent outcome of a targeted DA credential operation.",
      "oneOf": [
        {
          "const": "accepted",
          "description": "The operation may be claimed by the current registration.",
          "type": "string"
        },
        {
          "const": "pending_application",
          "description": "Custody accepted the observation and awaits an application acknowledgement.",
          "type": "string"
        },
        {
          "const": "reconciling",
          "description": "A verification operation is resolving the original uncertain attempt.",
          "type": "string"
        },
        {
          "const": "superseded",
          "description": "Another operation replaced this attempt before custody.",
          "type": "string"
        },
        {
          "const": "unchanged",
          "description": "Independent verification confirmed the previous credential.",
          "type": "string"
        },
        {
          "const": "retired",
          "description": "The original binding generation has been retired.",
          "type": "string"
        },
        {
          "const": "applied",
          "description": "The selected material was confirmed current on the device.",
          "type": "string"
        }
      ]
    },
    "CredentialSubject": {
      "description": "An exact Windows object, never an account display name or drive letter.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "RSS additional-factor recovery material, separate from local-account passwords.",
          "properties": {
            "binding": {
              "description": "Stable Device Access association.",
              "format": "uuid",
              "type": "string"
            },
            "bindingGeneration": {
              "description": "Exact association generation.",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "rss_login",
              "type": "string"
            },
            "sid": {
              "description": "Stable local account SID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "binding",
            "bindingGeneration",
            "sid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Numerical recovery protector on a stable volume.",
          "properties": {
            "kind": {
              "const": "bitlocker",
              "type": "string"
            },
            "protector": {
              "description": "Recovery protector identity.",
              "format": "uuid",
              "type": "string"
            },
            "volume": {
              "description": "Stable WMI volume DeviceID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "volume",
            "protector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit RSS-managed local account.",
          "properties": {
            "kind": {
              "const": "local_administrator",
              "type": "string"
            },
            "sid": {
              "description": "Stable Windows account SID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sid"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result of settling an event on the exact DA operation.",
  "properties": {
    "operationId": {
      "description": "Operation addressed by the device event.",
      "format": "uuid",
      "type": "string"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/CredentialReceipt"
        },
        {
          "type": "null"
        }
      ],
      "description": "Exact stored credential version when custody has completed."
    },
    "state": {
      "$ref": "#/$defs/CredentialState",
      "description": "Current settlement state."
    }
  },
  "required": [
    "operationId",
    "state"
  ],
  "title": "CredentialSettlement",
  "type": "object",
  "$id": "https://rss.example/da/v1/CredentialSettlement"
}
