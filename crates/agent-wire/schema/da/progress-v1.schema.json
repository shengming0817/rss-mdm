{
  "$defs": {
    "DeviceId": {
      "format": "uuid",
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Grant": {
      "additionalProperties": false,
      "description": "Durable grant receipt; possession of its secret is still required to issue.",
      "properties": {
        "device": {
          "$ref": "#/$defs/DeviceId",
          "description": "Registration-owner allocated endpoint identity."
        },
        "expiresAt": {
          "description": "Exclusive validity limit in Unix seconds.",
          "format": "int64",
          "type": "integer"
        },
        "grantId": {
          "description": "Identifier of the original persisted authorization.",
          "format": "uuid",
          "type": "string"
        },
        "operationId": {
          "description": "Stable caller operation identity; changed input under the same ID conflicts.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "grantId",
        "operationId",
        "device",
        "expiresAt"
      ],
      "type": "object"
    },
    "Registration": {
      "additionalProperties": false,
      "description": "Committed credential mapping after proof of possession.",
      "properties": {
        "credential": {
          "description": "Exact current credential identity.",
          "format": "uuid",
          "type": "string"
        },
        "device": {
          "$ref": "#/$defs/DeviceId",
          "description": "Registration-owner allocated endpoint identity."
        },
        "issuanceId": {
          "description": "Original persisted certificate signing attempt.",
          "format": "uuid",
          "type": "string"
        },
        "operationId": {
          "description": "Stable caller operation identity; changed input under the same ID conflicts.",
          "format": "uuid",
          "type": "string"
        },
        "serviceId": {
          "description": "Stable installation instance, independent of its network location.",
          "format": "uuid",
          "type": "string"
        },
        "tenant": {
          "description": "Tenant owning this identity and signing authority.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "serviceId",
        "tenant",
        "device",
        "credential",
        "issuanceId",
        "operationId"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Read-only original grant, signing and activation status.",
  "properties": {
    "grant": {
      "$ref": "#/$defs/Grant",
      "description": "Original grant receipt."
    },
    "issuanceId": {
      "description": "Original persisted certificate signing attempt.",
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "issuanceUnknown": {
      "description": "A dispatched attempt lacks a proven result; retry cannot sign again.",
      "type": "boolean"
    },
    "registration": {
      "anyOf": [
        {
          "$ref": "#/$defs/Registration"
        },
        {
          "type": "null"
        }
      ],
      "description": "Registration identity; renewed credentials retain the same generation."
    }
  },
  "required": [
    "grant",
    "issuanceUnknown"
  ],
  "title": "Progress",
  "type": "object",
  "$id": "https://rss.example/da/v1/Progress"
}
