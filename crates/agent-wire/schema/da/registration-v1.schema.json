{
  "$defs": {
    "DeviceId": {
      "format": "uuid",
      "maxLength": 36,
      "minLength": 36,
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      },
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Committed credential mapping after proof of possession.",
  "properties": {
    "credential": {
      "description": "Exact current credential identity.",
      "format": "uuid",
      "type": "string"
    },
    "device": {
      "$ref": "#/$defs/DeviceId",
      "description": "Registration-owner allocated endpoint identity."
    },
    "issuanceId": {
      "description": "Original persisted certificate signing attempt.",
      "format": "uuid",
      "type": "string"
    },
    "operationId": {
      "description": "Stable caller operation identity; changed input under the same ID conflicts.",
      "format": "uuid",
      "type": "string"
    },
    "serviceId": {
      "description": "Stable installation instance, independent of its network location.",
      "format": "uuid",
      "type": "string"
    },
    "tenant": {
      "description": "Tenant owning this identity and signing authority.",
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "serviceId",
    "tenant",
    "device",
    "credential",
    "issuanceId",
    "operationId"
  ],
  "title": "Registration",
  "type": "object",
  "$id": "https://rss.example/da/v1/Registration"
}
