{
  "$defs": {
    "DeliveryPermission": {
      "description": "Permission to transport content is separate from proof of its actual delivery channel.",
      "oneOf": [
        {
          "const": "da",
          "description": "DA transport is permitted.",
          "type": "string"
        },
        {
          "const": "managed_mandatory",
          "description": "Managed mandatory delivery is required by the consuming policy.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Export a currently published version. Callers cannot provide signable content.",
  "properties": {
    "delivery": {
      "$ref": "#/$defs/DeliveryPermission",
      "description": "Authorized delivery purpose."
    },
    "lifetimeSeconds": {
      "description": "Explicit lifetime within the host's configured ceiling.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "operationId": {
      "description": "Stable idempotency and artifact identity.",
      "format": "uuid",
      "type": "string"
    },
    "policy": {
      "description": "Policy selected by the administrator.",
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "description": "Exact immutable version; stale versions cannot be newly exported.",
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "operationId",
    "policy",
    "version",
    "delivery",
    "lifetimeSeconds"
  ],
  "title": "Export",
  "type": "object",
  "$id": "https://rss.example/da/v1/Export"
}
