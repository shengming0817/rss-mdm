{
  "$defs": {
    "CredentialEnvelope": {
      "additionalProperties": false,
      "description": "Ciphertext only; this structure is safe to persist in the ordinary communication journal.",
      "properties": {
        "ciphertext": {
          "description": "Base64 ciphertext with the 16-byte GCM tag appended.",
          "type": "string"
        },
        "expectedRevision": {
          "description": "Frozen revision before this operation.",
          "format": "int64",
          "type": "integer"
        },
        "nonce": {
          "description": "AES-GCM nonce.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 12,
          "minItems": 12,
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/CredentialSubject",
          "description": "Exact material identity."
        },
        "wrappedKey": {
          "description": "RSA-OAEP-SHA256 wrapped 32-byte AES key, base64 encoded.",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "expectedRevision",
        "wrappedKey",
        "nonce",
        "ciphertext"
      ],
      "type": "object"
    },
    "CredentialEscrow": {
      "additionalProperties": false,
      "description": "One bounded escrow batch, acknowledged only after durable storage.",
      "properties": {
        "definitionDigest": {
          "description": "Frozen task digest.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 32,
          "type": "array"
        },
        "materials": {
          "description": "Secret-bearing envelopes, never plaintext or diagnostic output.",
          "items": {
            "$ref": "#/$defs/CredentialEnvelope"
          },
          "type": "array"
        }
      },
      "required": [
        "definitionDigest",
        "materials"
      ],
      "type": "object"
    },
    "CredentialReceipt": {
      "additionalProperties": false,
      "description": "Durable escrow coordinates returned only for the exact accepted task event.",
      "properties": {
        "material": {
          "description": "Server-assigned entry identity.",
          "format": "uuid",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/CredentialSubject",
          "description": "Exact material subject."
        },
        "version": {
          "description": "Immutable material version.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "subject",
        "material",
        "version"
      ],
      "type": "object"
    },
    "CredentialSubject": {
      "description": "An exact Windows object, never an account display name or drive letter.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "RSS additional-factor recovery material, separate from local-account passwords.",
          "properties": {
            "binding": {
              "description": "Stable Device Access association.",
              "format": "uuid",
              "type": "string"
            },
            "bindingGeneration": {
              "description": "Exact association generation.",
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "rss_login",
              "type": "string"
            },
            "sid": {
              "description": "Stable local account SID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "binding",
            "bindingGeneration",
            "sid"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Numerical recovery protector on a stable volume.",
          "properties": {
            "kind": {
              "const": "bitlocker",
              "type": "string"
            },
            "protector": {
              "description": "Recovery protector identity.",
              "format": "uuid",
              "type": "string"
            },
            "volume": {
              "description": "Stable WMI volume DeviceID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "volume",
            "protector"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Explicit RSS-managed local account.",
          "properties": {
            "kind": {
              "const": "local_administrator",
              "type": "string"
            },
            "sid": {
              "description": "Stable Windows account SID.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "sid"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Device evidence for an exact DA credential execution.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "Device durably received this exact permit.",
      "properties": {
        "attemptId": {
          "description": "Attempt from the claim.",
          "format": "uuid",
          "type": "string"
        },
        "definitionDigest": {
          "description": "Frozen task definition.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 32,
          "type": "array"
        },
        "event": {
          "const": "received",
          "type": "string"
        }
      },
      "required": [
        "event",
        "attemptId",
        "definitionDigest"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Submit encrypted material for this attempt.",
      "properties": {
        "attemptId": {
          "description": "Attempt issued by the server in the claimed task.",
          "format": "uuid",
          "type": "string"
        },
        "event": {
          "const": "escrow",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/CredentialEscrow",
          "description": "Encrypted credential envelope and its frozen coordinates."
        }
      },
      "required": [
        "event",
        "attemptId",
        "value"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "Confirm an observed credential with its exact custody receipt.",
      "properties": {
        "attemptId": {
          "description": "Attempt issued by the server in the claimed task.",
          "format": "uuid",
          "type": "string"
        },
        "definitionDigest": {
          "description": "Digest of the definition from the original claim.",
          "items": {
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 32,
          "minItems": 32,
          "type": "array"
        },
        "event": {
          "const": "applied",
          "type": "string"
        },
        "receipt": {
          "$ref": "#/$defs/CredentialReceipt",
          "description": "Previously issued custody receipt for the observed version."
        }
      },
      "required": [
        "event",
        "attemptId",
        "definitionDigest",
        "receipt"
      ],
      "type": "object"
    }
  ],
  "title": "CredentialEvent",
  "$id": "https://rss.example/da/v1/CredentialEvent"
}
