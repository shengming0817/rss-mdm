{
  "listen": "127.0.0.1:8081",
  "product_origin": "https://mdm.example.test",
  "identity": {
    "origin": "https://identity-private.example.test",
    "issuer": "https://identity.example.test/oidc",
    "client_id": "mdm",
    "tenant_id": "11111111-1111-4111-8111-111111111111",
    "audience": "mdm-api",
    "oidc_secret_file": "/private/mdm-oidc-secret",
    "validation_secret_file": "/private/mdm-validation-secret",
    "ca_file": "/private/identity-ca.pem"
  },
  "database": {
    "host": "postgres.example.test",
    "port": 5432,
    "name": "mdm",
    "user": "mdm_api",
    "password_file": "/private/mdm-api-password",
    "ca_file": "/private/database-ca.pem"
  },
  "bindings": [
    {
      "tenant_id": "11111111-1111-4111-8111-111111111111",
      "client_id": "mdm",
      "subject": "replace-with-subject-from-auth-me",
      "roles": [
        "auditor"
      ],
      "devices": [
        "replace-with-device-id"
      ],
      "allow_wipe": false,
      "allow_enrollment": false,
      "allow_manage_credentials": false
    }
  ],
  "access_database": {
    "host": "postgres.example.test",
    "port": 5432,
    "name": "mdm",
    "user": "mdm_access",
    "password_file": "/private/mdm-access-password",
    "ca_file": "/private/database-ca.pem"
  },
  "windows": {
    "enrollment": {
      "listen": "0.0.0.0:8443",
      "origin": "https://enroll.example.test:8443",
      "certificate_file": "/private/enrollment-tls.pem",
      "private_key_file": "/private/enrollment-tls.pk8"
    },
    "management": {
      "listen": "0.0.0.0:8444",
      "origin": "https://manage.example.test:8444",
      "certificate_file": "/private/management-tls.pem",
      "private_key_file": "/private/management-tls.pk8"
    },
    "ca_certificate_file": "/private/enrollment-ca.pem",
    "ca_private_key_file": "/private/enrollment-ca.pk8",
    "protocol_key_file": "/private/protocol.key",
    "provider_id": "RSS-MDM"
  }
}
